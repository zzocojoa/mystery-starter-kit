{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/runtime/runtime-run-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_family", "schema_version", "run_id", "project_id", "project_path", "status", "from_gate", "to_gate", "route_profile", "reference_source", "current_task_id", "tasks", "created_at", "updated_at", "cancel_requested", "error"],
  "properties": {
    "schema_family": {"const": "runtime-run"},
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^RUN-[0-9]{8}T[0-9]{6}Z-[A-F0-9]{8}$"},
    "project_id": {"type": "string", "pattern": "^PRJ-[0-9]{3,}$"},
    "project_path": {"type": "string", "minLength": 1},
    "status": {"enum": ["CREATED", "PLANNED", "RUNNING", "WAITING_PROVIDER", "VALIDATING", "REVISING", "WAITING_HUMAN", "COMPLETED", "FAILED", "CANCELLED"]},
    "from_gate": {"type": "string", "pattern": "^GATE-(0[0-9]|1[0-3])$"},
    "to_gate": {"type": "string", "pattern": "^GATE-(0[0-9]|1[0-3])$"},
    "route_profile": {"type": "string", "minLength": 1},
    "reference_source": {"type": ["string", "null"]},
    "current_task_id": {"type": ["string", "null"]},
    "tasks": {"type": "object", "additionalProperties": {"$ref": "#/$defs/taskState"}},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "cancel_requested": {"type": "boolean"},
    "error": {"type": ["object", "null"]}
  },
  "$defs": {
    "taskState": {"type": "object", "additionalProperties": false, "required": ["status", "attempt", "provider_id", "model_resolved", "input_hashes", "prompt_hash", "error"], "properties": {"status": {"enum": ["PENDING", "READY", "RUNNING", "RETRYING", "SUCCEEDED", "FAILED", "BLOCKED", "SKIPPED", "CANCELLED"]}, "attempt": {"type": "integer", "minimum": 0}, "provider_id": {"type": ["string", "null"]}, "model_resolved": {"type": ["string", "null"]}, "input_hashes": {"type": "object", "additionalProperties": {"type": "string"}}, "prompt_hash": {"type": ["string", "null"]}, "error": {"type": ["object", "null"]}}}
  }
}
