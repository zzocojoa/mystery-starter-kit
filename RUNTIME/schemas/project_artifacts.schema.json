{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/runtime/project-artifacts-1.0.0.json",
  "$defs": {
    "projectId": {"type": "string", "pattern": "^PRJ-[0-9]{3,}$"},
    "canonicalId": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2,}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nonEmptyString": {"type": "string", "minLength": 1},
    "stringList": {"type": "array", "items": {"type": "string"}},
    "nonEmptyStringList": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "compatibilityReport": {
      "type": "object",
      "required": ["project_id", "channel", "compatibility", "errors"],
      "properties": {
        "project_id": {"$ref": "#/$defs/projectId"},
        "channel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "channel_id",
            "schema_family",
            "schema_version",
            "content_version",
            "channel_dna_sha256",
            "relative_path"
          ],
          "properties": {
            "channel_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
            "schema_family": {"const": "channel-dna"},
            "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "content_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "channel_dna_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "relative_path": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.json$"
            }
          }
        },
        "compatibility": {"enum": ["PASS", "FAIL"]},
        "errors": {"type": "array"}
      }
    },
    "caseInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "title_working", "source_type", "central_mystery", "final_truth", "causal_truth", "culprit", "culprit_motive", "restrictions"],
      "properties": {
        "project_id": {"$ref": "#/$defs/projectId"},
        "title_working": {"$ref": "#/$defs/nonEmptyString"},
        "source_type": {"enum": ["FICTION", "USER_CASE", "TRUE_STORY", "INSPIRED_BY_TRUE_EVENTS"]},
        "central_mystery": {"$ref": "#/$defs/nonEmptyString"},
        "final_truth": {"$ref": "#/$defs/nonEmptyString"},
        "causal_truth": {"$ref": "#/$defs/nonEmptyString"},
        "incident_type": {"type": "string"},
        "setting": {"type": "string"},
        "responsible_agent_structure": {"type": "string"},
        "legal_outcome": {"type": ["string", "null"]},
        "victim": {"type": ["string", "null"]},
        "method": {"type": ["string", "null"]},
        "unique_objects": {"$ref": "#/$defs/stringList"},
        "culprit": {"type": ["string", "null"]},
        "culprit_motive": {"type": ["string", "null"]},
        "restrictions": {"$ref": "#/$defs/stringList"}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "statement", "classification", "normalized_statement_hash"],
      "properties": {
        "fact_id": {"$ref": "#/$defs/canonicalId"},
        "statement": {"$ref": "#/$defs/nonEmptyString"},
        "classification": {"enum": ["FACT", "INFERENCE", "DRAMATIZATION"]},
        "normalized_statement_hash": {"$ref": "#/$defs/hash"},
        "source_ids": {"$ref": "#/$defs/stringList"},
        "basis_fact_ids": {"$ref": "#/$defs/stringList"},
        "presented_as_fact": {"type": "boolean"}
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "facts"],
      "properties": {"project_id": {"$ref": "#/$defs/projectId"}, "facts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fact"}}}
    },
    "sourceCaseBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "source_truth_classification", "source_ids", "verified_fact_ids", "brief"],
      "properties": {
        "project_id": {"$ref": "#/$defs/projectId"},
        "source_truth_classification": {"enum": ["VERIFIED_TRUE_CASE", "INSPIRED_BY_TRUE_EVENTS"]},
        "source_ids": {"$ref": "#/$defs/nonEmptyStringList"},
        "verified_fact_ids": {"$ref": "#/$defs/nonEmptyStringList"},
        "brief": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "verifiedFactLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "facts"],
      "properties": {
        "project_id": {"$ref": "#/$defs/projectId"},
        "facts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fact"}}
      }
    },
    "sourceSubjects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "subjects"],
      "properties": {
        "project_id": {"$ref": "#/$defs/projectId"},
        "subjects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_subject_id", "pseudonym", "source_role", "related_fact_ids", "identity_disclosure_level"],
            "properties": {
              "source_subject_id": {"type": "string", "pattern": "^SUBJECT-[0-9]{2,}$"},
              "pseudonym": {"$ref": "#/$defs/nonEmptyString"},
              "source_role": {"$ref": "#/$defs/nonEmptyString"},
              "related_fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/canonicalId"}},
              "identity_disclosure_level": {"enum": ["PUBLIC", "PSEUDONYMIZED", "RESTRICTED"]}
            }
          }
        }
      }
    },
    "verifiedEventLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "events"],
      "properties": {
        "project_id": {"$ref": "#/$defs/projectId"},
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["verified_event_id", "statement", "sequence", "participant_source_subject_ids", "source_claim_ids"],
            "properties": {
              "verified_event_id": {"type": "string", "pattern": "^VEVT-[0-9]{2,}$"},
              "statement": {"$ref": "#/$defs/nonEmptyString"},
              "sequence": {"type": "integer", "minimum": 1},
              "setting": {"type": ["string", "null"]},
              "participant_source_subject_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SUBJECT-[0-9]{2,}$"}},
              "source_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/canonicalId"}}
            }
          }
        }
      }
    },
    "sourceTruthContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "source_truth_classification", "locked_dimensions", "verified_subject_ids", "verified_event_ids", "verified_relationships", "verified_incident_type", "verified_setting", "verified_responsible_agent_structure", "verified_legal_outcome", "flexible_dimensions", "unknown_dimensions", "source_claim_ids", "bound_artifact_hashes", "evidence_bundle_sha256", "contract_sha256"],
      "properties": {
        "project_id": {"$ref": "#/$defs/projectId"},
        "source_truth_classification": {"enum": ["VERIFIED_TRUE_CASE", "INSPIRED_BY_TRUE_EVENTS"]},
        "locked_dimensions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "verified_subject_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SUBJECT-[0-9]{2,}$"}},
        "verified_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^VEVT-[0-9]{2,}$"}},
        "verified_relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from_source_subject_id", "to_source_subject_id", "relationship_type", "source_claim_ids"],
            "properties": {
              "from_source_subject_id": {"type": "string", "pattern": "^SUBJECT-[0-9]{2,}$"},
              "to_source_subject_id": {"type": "string", "pattern": "^SUBJECT-[0-9]{2,}$"},
              "relationship_type": {"$ref": "#/$defs/nonEmptyString"},
              "source_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/canonicalId"}}
            }
          }
        },
        "verified_incident_type": {"type": ["string", "null"]},
        "verified_setting": {"type": ["string", "null"]},
        "verified_responsible_agent_structure": {"type": ["string", "null"]},
        "verified_legal_outcome": {"type": ["string", "null"]},
        "flexible_dimensions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "unknown_dimensions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "source_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/canonicalId"}},
        "bound_artifact_hashes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sources", "claim_evidence", "verified_fact_ledger", "source_subjects", "verified_event_ledger"],
          "properties": {
            "sources": {"$ref": "#/$defs/hash"},
            "claim_evidence": {"$ref": "#/$defs/hash"},
            "verified_fact_ledger": {"$ref": "#/$defs/hash"},
            "source_subjects": {"$ref": "#/$defs/hash"},
            "verified_event_ledger": {"$ref": "#/$defs/hash"}
          }
        },
        "evidence_bundle_sha256": {"$ref": "#/$defs/hash"},
        "contract_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "sources"],
      "properties": {"project_id": {"$ref": "#/$defs/projectId"}, "sources": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "url", "retrieved_at", "evidence_locator", "verification_actor", "verification_status"], "properties": {"source_id": {"$ref": "#/$defs/canonicalId"}, "url": {"$ref": "#/$defs/nonEmptyString"}, "title": {"type": "string"}, "publisher": {"type": "string"}, "published_at": {"type": "string"}, "source_type": {"enum": ["PRIMARY", "SECONDARY", "COURT_RECORD", "OFFICIAL_RECORD", "NEWS", "EXPERT_PUBLICATION"]}, "retrieved_at": {"type": "string", "format": "date-time"}, "evidence_locator": {"$ref": "#/$defs/nonEmptyString"}, "source_snapshot_sha256": {"$ref": "#/$defs/hash"}, "archive_locator": {"$ref": "#/$defs/nonEmptyString"}, "verification_actor": {"$ref": "#/$defs/nonEmptyString"}, "verification_status": {"enum": ["VERIFIED", "REJECTED", "PENDING"]}}, "oneOf": [{"required": ["source_snapshot_sha256"], "not": {"required": ["archive_locator"]}}, {"required": ["archive_locator"], "not": {"required": ["source_snapshot_sha256"]}}]}}}
    },
    "claimEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "claims"],
      "properties": {"project_id": {"$ref": "#/$defs/projectId"}, "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}}}
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "claim", "classification", "canonical_claim_hash", "evidence_source_ids", "basis_fact_ids", "evidence_scope", "confidence", "presented_as_fact"],
      "properties": {
        "fact_id": {"$ref": "#/$defs/canonicalId"},
        "claim": {"$ref": "#/$defs/nonEmptyString"},
        "classification": {"enum": ["FACT", "INFERENCE", "DRAMATIZATION"]},
        "canonical_claim_hash": {"$ref": "#/$defs/hash"},
        "evidence_source_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/canonicalId"}},
        "basis_fact_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/canonicalId"}},
        "evidence_scope": {"type": "string"},
        "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "presented_as_fact": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"classification": {"const": "FACT"}}}, "then": {"properties": {"evidence_source_ids": {"minItems": 1}, "presented_as_fact": {"const": true}}}},
        {"if": {"properties": {"classification": {"const": "INFERENCE"}}}, "then": {"properties": {"basis_fact_ids": {"minItems": 1}}}},
        {"if": {"properties": {"classification": {"const": "DRAMATIZATION"}}}, "then": {"properties": {"presented_as_fact": {"const": false}}}}
      ]
    },
    "characters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "characters"],
      "properties": {"project_id": {"$ref": "#/$defs/projectId"}, "characters": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["character_id", "name", "role"], "properties": {"character_id": {"$ref": "#/$defs/canonicalId"}, "name": {"$ref": "#/$defs/nonEmptyString"}, "role": {"$ref": "#/$defs/nonEmptyString"}, "production_role": {"enum": ["MAJOR", "SUPPORTING", "BACKGROUND"]}, "source_subject_id": {"type": "string", "pattern": "^SUBJECT-[0-9]{2,}$"}, "goal": {"type": "string"}, "secret": {"type": "string"}}}}}
    },
    "relationships": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "relationships"],
      "properties": {"project_id": {"$ref": "#/$defs/projectId"}, "relationships": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["relationship_id", "from", "to", "engine"], "properties": {"relationship_id": {"$ref": "#/$defs/canonicalId"}, "from": {"$ref": "#/$defs/canonicalId"}, "to": {"$ref": "#/$defs/canonicalId"}, "engine": {"$ref": "#/$defs/nonEmptyString"}}}}}
    },
    "knowledgeMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "knowledge_events"],
      "properties": {"project_id": {"$ref": "#/$defs/projectId"}, "knowledge_events": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["character_id", "fact_id", "learned_scene_order"], "properties": {"character_id": {"$ref": "#/$defs/canonicalId"}, "fact_id": {"$ref": "#/$defs/canonicalId"}, "learned_scene_order": {"type": "integer", "minimum": 1}}}}}
    },
    "actualTimeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "events"],
      "properties": {"project_id": {"$ref": "#/$defs/projectId"}, "events": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["event_id", "start_minute", "end_minute", "location_id", "participant_ids"], "properties": {"event_id": {"$ref": "#/$defs/canonicalId"}, "source_event_id": {"type": "string", "pattern": "^VEVT-[0-9]{2,}$"}, "start_minute": {"type": "number", "minimum": 0}, "end_minute": {"type": "number", "exclusiveMinimum": 0}, "location_id": {"$ref": "#/$defs/nonEmptyString"}, "participant_ids": {"$ref": "#/$defs/nonEmptyStringList"}, "description": {"type": "string"}}}}}
    },
    "viewerTimeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "reveals"],
      "properties": {"project_id": {"$ref": "#/$defs/projectId"}, "reveals": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["reveal_id", "fact_id"], "properties": {"reveal_id": {"$ref": "#/$defs/canonicalId"}, "scene_id": {"$ref": "#/$defs/canonicalId"}, "scene_order": {"type": "integer", "minimum": 1}, "fact_id": {"$ref": "#/$defs/canonicalId"}, "reveal_target_id": {"type": "string", "pattern": "^REVEAL-TARGET-[0-9]{2,}$"}, "intentional_prereveal": {"type": "boolean"}, "information": {"type": "string"}, "effect": {"type": "string"}}, "anyOf": [{"required": ["scene_id"]}, {"required": ["scene_order"]}]}}}
    },
    "audienceBelief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "belief_states"],
      "properties": {"project_id": {"$ref": "#/$defs/projectId"}, "belief_states": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["belief", "confidence", "known_fact_ids", "active_hypothesis_ids"], "properties": {"scene_id": {"$ref": "#/$defs/canonicalId"}, "scene_order": {"type": "integer", "minimum": 1}, "belief": {"$ref": "#/$defs/nonEmptyString"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "known_fact_ids": {"$ref": "#/$defs/stringList"}, "active_hypothesis_ids": {"$ref": "#/$defs/stringList"}}, "anyOf": [{"required": ["scene_id"]}, {"required": ["scene_order"]}]}}}
    },
    "clueMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "clues"],
      "properties": {"project_id": {"$ref": "#/$defs/projectId"}, "final_proof_mechanism": {"type": "string"}, "technical_dependency_level": {"type": "string"}, "clues": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["clue_id", "role", "introduced_scene_order", "introduced_scene_id"], "properties": {"clue_id": {"$ref": "#/$defs/canonicalId"}, "role": {"enum": ["CORE", "RED_HERRING", "SUPPORTING"]}, "evidence_class": {"enum": ["RELATIONAL", "LINGUISTIC", "BEHAVIORAL", "TESTIMONIAL", "DOCUMENTARY", "PHYSICAL_OBJECT", "OWNERSHIP", "SOCIAL", "TECHNICAL"]}, "independent_ground_id": {"type": "string", "pattern": "^GROUND-[0-9]{2,}$"}, "supports_final_reveal": {"type": "boolean"}, "introduced_scene_order": {"type": "integer", "minimum": 1}, "introduced_scene_id": {"$ref": "#/$defs/canonicalId"}, "resolved_scene_order": {"type": ["integer", "null"], "minimum": 1}, "resolved_scene_id": {"type": ["string", "null"]}, "description": {"type": "string"}, "content": {"type": "string"}, "mechanism": {"type": "string"}, "first_interpretation": {"type": "string"}, "true_meaning": {"type": "string"}, "object": {"type": "string"}, "object_name": {"type": "string"}, "evidence_object": {"type": "string"}}}}}
    },
    "hypothesisLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "hypotheses"],
      "properties": {"project_id": {"$ref": "#/$defs/projectId"}, "hypotheses": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["hypothesis_id", "status"], "properties": {"hypothesis_id": {"$ref": "#/$defs/canonicalId"}, "status": {"enum": ["ACTIVE", "SUPPORTED", "REJECTED", "CONFIRMED"]}, "claim": {"type": "string"}}}}}
    },
    "beatSheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "architecture", "beats"],
      "properties": {"project_id": {"$ref": "#/$defs/projectId"}, "architecture": {"$ref": "#/$defs/nonEmptyString"}, "beats": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["beat_id", "type"], "properties": {"beat_id": {"$ref": "#/$defs/canonicalId"}, "type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}, "purpose": {"type": "string"}}}}}
    },
    "retentionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "checkpoints"],
      "properties": {"project_id": {"$ref": "#/$defs/projectId"}, "checkpoints": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["scene_id", "function"], "properties": {"scene_id": {"$ref": "#/$defs/canonicalId"}, "function": {"$ref": "#/$defs/nonEmptyString"}}}}}
    },
    "sceneCards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "scenes"],
      "properties": {"project_id": {"$ref": "#/$defs/projectId"}, "scenes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["scene_id", "order", "beat_id", "estimated_seconds", "clue_ids", "knowledge_claims"], "properties": {"scene_id": {"$ref": "#/$defs/canonicalId"}, "order": {"type": "integer", "minimum": 1}, "beat_id": {"$ref": "#/$defs/canonicalId"}, "estimated_seconds": {"type": "number", "exclusiveMinimum": 0}, "clue_ids": {"$ref": "#/$defs/stringList"}, "knowledge_claims": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["character_id", "fact_id"], "properties": {"character_id": {"$ref": "#/$defs/canonicalId"}, "fact_id": {"$ref": "#/$defs/canonicalId"}}}}, "psychological_realization": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/psychologicalRealization"}}, "crime_realization": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/crimeRealization"}}, "location_id": {"type": "string", "minLength": 1}, "cast_ids": {"$ref": "#/$defs/stringList"}, "child_actor_use": {"enum": ["NONE", "SUPPORTING", "PRIMARY"]}, "vehicle_scene": {"enum": ["NONE", "STATIC", "MOVING"]}, "special_effect_level": {"enum": ["NONE", "LOW", "MEDIUM", "HIGH"]}, "graphic_violence": {"enum": ["NONE", "IMPLIED", "NON_GRAPHIC", "GRAPHIC"]}, "production_complexity": {"enum": ["LOW", "MEDIUM", "HIGH", "EXTREME"]}, "summary": {"type": "string"}}}}}
    },
    "crimeRealization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "harm_ids", "actor_ids", "victim_ids", "realization_mode", "action_evidence", "dialogue_or_behavior_evidence", "choice_or_emotion_change", "result_change", "planned_segment_ids", "expected_excerpt_anchor"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^EVENT-[0-9]{2,}$"},
        "harm_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^HARM-[0-9]{2,}$"}},
        "actor_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/canonicalId"}},
        "victim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/canonicalId"}},
        "realization_mode": {"enum": ["DIRECT_ACTION", "IMPLIED_ACTION", "AFTERMATH_CAUSAL"]},
        "action_evidence": {"$ref": "#/$defs/nonEmptyString"},
        "dialogue_or_behavior_evidence": {"$ref": "#/$defs/nonEmptyString"},
        "choice_or_emotion_change": {"$ref": "#/$defs/nonEmptyString"},
        "result_change": {"$ref": "#/$defs/nonEmptyString"},
        "planned_segment_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SEG-[0-9]{3,}$"}},
        "expected_excerpt_anchor": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "psychologicalRealization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "stage_type", "trace_ids", "actor_id", "subject_id", "state_before", "state_after", "on_screen_evidence", "satisfaction_mode"],
      "properties": {
        "stage_id": {"type": "string", "pattern": "^PSTAGE-[0-9]{3,}$"},
        "stage_type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "trace_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*-[0-9]{2,}$"}},
        "actor_id": {"$ref": "#/$defs/canonicalId"},
        "subject_id": {"$ref": "#/$defs/canonicalId"},
        "state_before": {"$ref": "#/$defs/nonEmptyString"},
        "state_after": {"$ref": "#/$defs/nonEmptyString"},
        "on_screen_evidence": {"$ref": "#/$defs/nonEmptyString"},
        "satisfaction_mode": {"enum": ["DRAMA", "DRAMA_REQUIRED", "NARRATION_ONLY", "PANEL_ONLY"]}
      }
    },
    "presentationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_family", "schema_version", "project_id", "modes", "segments"],
      "properties": {
        "schema_family": {"const": "presentation-plan"},
        "schema_version": {"enum": ["2.0.0", "2.1.0"]},
        "project_id": {"$ref": "#/$defs/projectId"},
        "modes": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"enum": ["DRAMA", "NARRATION", "PANEL_REACTION", "AUDIENCE_PROMPT", "EXPERT_ANALYSIS"]}},
        "segments": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["segment_id", "segment_type", "scene_id", "start_sec", "duration_sec", "source_artifact", "revealed_fact_ids", "revealed_clue_ids"], "properties": {"segment_id": {"type": "string", "pattern": "^SEG-[0-9]{3,}$"}, "segment_type": {"enum": ["DRAMA", "NARRATION", "PANEL_REACTION", "AUDIENCE_PROMPT", "EXPERT_ANALYSIS"]}, "scene_id": {"$ref": "#/$defs/canonicalId"}, "reaction_segment_id": {"type": "string", "pattern": "^RSEG-[0-9]{3,}$"}, "start_sec": {"type": "number", "minimum": 0}, "duration_sec": {"type": "number", "exclusiveMinimum": 0}, "source_artifact": {"enum": ["drama_script", "narration_script", "panel_reaction_script", "expert_analysis_script"]}, "revealed_fact_ids": {"$ref": "#/$defs/stringList"}, "revealed_clue_ids": {"$ref": "#/$defs/stringList"}, "referenced_fact_ids": {"$ref": "#/$defs/stringList"}, "referenced_clue_ids": {"$ref": "#/$defs/stringList"}, "referenced_reveal_target_ids": {"$ref": "#/$defs/stringList"}, "revealed_reveal_target_ids": {"$ref": "#/$defs/stringList"}, "intentional_prereveal_ids": {"$ref": "#/$defs/stringList"}, "psychological_stage_ids": {"$ref": "#/$defs/stringList"}, "psychological_stage_types": {"$ref": "#/$defs/stringList"}, "narrator_character_id": {"$ref": "#/$defs/canonicalId"}, "narration_function": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}}}}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message", "artifact", "context"],
      "properties": {"severity": {"enum": ["ERROR", "WARN", "INFO"]}, "code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "artifact": {"type": "string", "minLength": 1}, "context": {"type": "object"}}
    },
    "qaReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "result", "issues"],
      "properties": {"project_id": {"$ref": "#/$defs/projectId"}, "result": {"enum": ["PASS", "FAIL"]}, "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}}, "scene_realization_evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sceneRealizationEvidence"}}, "crime_realization_evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/crimeRealizationEvidence"}}}
    },
    "sceneRealizationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "scene_id", "segment_id", "excerpt_hash"],
      "properties": {
        "stage_id": {"type": "string", "pattern": "^PSTAGE-[0-9]{3,}$"},
        "scene_id": {"type": "string", "pattern": "^SCN-[0-9]{2,}$"},
        "segment_id": {"type": "string", "pattern": "^SEG-[0-9]{3,}$"},
        "excerpt_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "crimeRealizationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_type", "target_id", "status", "scene_id", "segment_id", "excerpt_hash"],
      "properties": {
        "target_type": {"enum": ["EVENT", "REVEAL"]},
        "target_id": {"type": "string", "pattern": "^(EVENT|REVEAL-TARGET)-[0-9]{2,}$"},
        "scene_id": {"anyOf": [{"type": "string", "pattern": "^SCN-[0-9]{2,}$"}, {"type": "null"}]},
        "segment_id": {"anyOf": [{"type": "string", "pattern": "^SEG-[0-9]{3,}$"}, {"type": "null"}]},
        "excerpt_hash": {"anyOf": [{"type": "string", "pattern": "^[a-f0-9]{64}$"}, {"type": "null"}]},
        "status": {"enum": ["NEEDS_REVIEW", "MISSING"]}
      }
    },
    "noveltyReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "result", "comparison_status", "comparisons", "hard_collisions", "semantic_hard_collisions", "issues"],
      "properties": {"project_id": {"$ref": "#/$defs/projectId"}, "result": {"enum": ["PASS", "FAIL"]}, "comparison_status": {"enum": ["COMPARISON_COMPLETE", "NO_COMPARISON_DATA"]}, "comparisons": {"type": "array", "items": {"type": "object"}}, "hard_collisions": {"type": "array", "items": {"type": "string"}}, "semantic_hard_collisions": {"type": "array", "items": {"type": "string"}}, "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}}}
    },
    "referenceReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "reference_id", "result", "lexical_collision_count", "matched_story_element_categories", "issues"],
      "properties": {
        "project_id": {"$ref": "#/$defs/projectId"},
        "reference_id": {"type": ["string", "null"]},
        "result": {"enum": ["PASS", "FAIL"]},
        "lexical_collision_count": {"type": "integer", "minimum": 0},
        "matched_story_element_categories": {"type": "array", "items": {"type": "string"}},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}}
      }
    }
  }
}
