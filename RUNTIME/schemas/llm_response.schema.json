{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/runtime/llm-response-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "provider_request_id", "status", "finish_reason", "text", "structured_output", "tool_calls", "usage", "model_resolved", "warnings"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "provider_request_id": {"type": ["string", "null"]},
    "status": {"enum": ["COMPLETED", "REFUSED", "FAILED"]},
    "finish_reason": {"enum": ["STOP", "LENGTH", "TOOL_CALL", "FILTERED", "ERROR"]},
    "text": {"type": ["string", "null"]},
    "structured_output": {"type": ["object", "null"]},
    "tool_calls": {"type": "array", "items": {"type": "object"}},
    "usage": {"type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens", "cached_tokens"], "properties": {"input_tokens": {"type": ["integer", "null"], "minimum": 0}, "output_tokens": {"type": ["integer", "null"], "minimum": 0}, "cached_tokens": {"type": ["integer", "null"], "minimum": 0}}},
    "model_resolved": {"type": "string", "minLength": 1},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
