{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/runtime/provider-registry-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_family", "schema_version", "providers"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_family": {"const": "provider-registry"},
    "schema_version": {"type": "string"},
    "providers": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/provider"}}
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_type", "adapter_entry_point", "enabled", "credential_env", "endpoint", "data_policy"],
      "properties": {
        "adapter_type": {"enum": ["IN_PROCESS_PLUGIN", "SIDECAR_HTTP"]},
        "adapter_entry_point": {"type": "string", "minLength": 1},
        "enabled": {"type": "boolean"},
        "credential_env": {"type": ["string", "null"]},
        "endpoint": {"type": ["string", "null"]},
        "data_policy": {"type": "object", "additionalProperties": false, "required": ["allowed_classes"], "properties": {"allowed_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["PUBLIC", "INTERNAL", "SENSITIVE", "REFERENCE_SANITIZED", "REFERENCE_RAW", "PERSONAL_DATA"]}}}}
      }
    }
  }
}
