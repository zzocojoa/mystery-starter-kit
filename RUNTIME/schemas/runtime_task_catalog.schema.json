{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/runtime/runtime-task-catalog-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_family", "schema_version", "tasks"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_family": {"const": "runtime-task-catalog"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "tasks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_.]+$"},
      "additionalProperties": {"$ref": "#/$defs/task"}
    }
  },
  "$defs": {
    "stringList": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "executor", "target_gate", "reads", "writes", "depends_on_tasks", "condition", "model_profile", "output_contract", "commit_policy", "retry_policy", "budget_profile", "standard_resources", "allowed_tools", "required_data_classes", "approval_required"],
      "properties": {
        "agent_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "executor": {"enum": ["CORE", "LLM", "HYBRID", "HUMAN", "COMPOSITE"]},
        "target_gate": {"type": "string", "pattern": "^GATE-(0[0-9]|1[0-3])$"},
        "reads": {"$ref": "#/$defs/stringList"},
        "optional_reads": {"$ref": "#/$defs/stringList"},
        "writes": {"$ref": "#/$defs/nonEmptyStringList"},
        "depends_on_tasks": {"$ref": "#/$defs/stringList"},
        "condition": {"$ref": "#/$defs/predicate"},
        "model_profile": {"type": ["string", "null"]},
        "output_contract": {"type": "string", "minLength": 1},
        "commit_policy": {"enum": ["ATOMIC_ON_PASS", "ALWAYS_DIAGNOSTIC", "EPHEMERAL"]},
        "retry_policy": {"type": "string", "minLength": 1},
        "budget_profile": {"type": "string", "minLength": 1},
        "standard_resources": {"$ref": "#/$defs/stringList"},
        "allowed_tools": {"$ref": "#/$defs/stringList"},
        "required_data_classes": {"$ref": "#/$defs/nonEmptyStringList"},
        "approval_required": {"type": "boolean"}
      }
    },
    "nonEmptyStringList": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "predicate": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["always"], "properties": {"always": {"const": true}}},
        {"type": "object", "additionalProperties": false, "required": ["all"], "properties": {"all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/predicate"}}}},
        {"type": "object", "additionalProperties": false, "required": ["any"], "properties": {"any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/predicate"}}}},
        {"type": "object", "additionalProperties": false, "required": ["not"], "properties": {"not": {"$ref": "#/$defs/predicate"}}},
        {"type": "object", "additionalProperties": false, "required": ["capability_enabled"], "properties": {"capability_enabled": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}}},
        {"type": "object", "additionalProperties": false, "required": ["source_truth_in"], "properties": {"source_truth_in": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}},
        {"type": "object", "additionalProperties": false, "required": ["story_source_mode_in"], "properties": {"story_source_mode_in": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}},
        {"type": "object", "additionalProperties": false, "required": ["config_equals"], "properties": {"config_equals": {"type": "array", "prefixItems": [{"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, {"type": ["string", "number", "boolean", "null"]}], "items": false}}},
        {"type": "object", "additionalProperties": false, "required": ["channel_version_at_least"], "properties": {"channel_version_at_least": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["artifact_status"], "properties": {"artifact_status": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "string"}], "items": false}}},
        {"type": "object", "additionalProperties": false, "required": ["artifact_exists"], "properties": {"artifact_exists": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["production_footprint_enforced"], "properties": {"production_footprint_enforced": {"const": true}}}
      ]
    }
  }
}
