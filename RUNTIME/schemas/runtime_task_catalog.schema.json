{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/runtime/runtime-task-catalog-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_family", "schema_version", "tasks"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_family": {"const": "runtime-task-catalog"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "tasks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_.]+$"},
      "additionalProperties": {"$ref": "#/$defs/task"}
    }
  },
  "$defs": {
    "stringList": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "executor", "target_gate", "reads", "writes", "depends_on_tasks", "condition", "model_profile", "output_contract", "commit_policy", "retry_policy", "budget_profile", "standard_resources", "allowed_tools", "required_data_classes", "approval_required"],
      "properties": {
        "agent_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "executor": {"enum": ["CORE", "LLM", "HYBRID", "HUMAN", "COMPOSITE"]},
        "target_gate": {"type": "string", "pattern": "^GATE-(0[0-9]|1[0-3])$"},
        "reads": {"$ref": "#/$defs/stringList"},
        "optional_reads": {"$ref": "#/$defs/stringList"},
        "writes": {"$ref": "#/$defs/nonEmptyStringList"},
        "depends_on_tasks": {"$ref": "#/$defs/stringList"},
        "condition": {
          "type": "string",
          "pattern": "^(ALWAYS|REFERENCE_ONLY|TRUE_STORY_ONLY|CAPABILITY_ENABLED:[A-Z][A-Z0-9_]*|FACT_BASED_OR_CAPABILITY_ENABLED:[A-Z][A-Z0-9_]*|ARTIFACT_STATUS:[a-z][a-z0-9_]*:[A-Z][A-Z0-9_]*|ARTIFACT_EXISTS:[a-z][a-z0-9_]*)$"
        },
        "model_profile": {"type": ["string", "null"]},
        "output_contract": {"type": "string", "minLength": 1},
        "commit_policy": {"enum": ["ATOMIC_ON_PASS", "ALWAYS_DIAGNOSTIC", "EPHEMERAL"]},
        "retry_policy": {"type": "string", "minLength": 1},
        "budget_profile": {"type": "string", "minLength": 1},
        "standard_resources": {"$ref": "#/$defs/stringList"},
        "allowed_tools": {"$ref": "#/$defs/stringList"},
        "required_data_classes": {"$ref": "#/$defs/nonEmptyStringList"},
        "approval_required": {"type": "boolean"}
      }
    },
    "nonEmptyStringList": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
