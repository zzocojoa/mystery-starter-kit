{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/runtime/evidence-input-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_family",
    "schema_version",
    "project_id",
    "task_id",
    "source_truth_classification",
    "sources",
    "claims",
    "source_subjects",
    "verified_events",
    "source_truth_contract",
    "source_disclosure",
    "clinical_labels",
    "actor",
    "reason",
    "submitted_at",
    "bound_input_hashes"
  ],
  "properties": {
    "schema_family": {"const": "evidence-input"},
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "pattern": "^PRJ-[0-9]{3,}$"},
    "task_id": {"const": "reference.intake_evidence"},
    "source_truth_classification": {
      "enum": ["VERIFIED_TRUE_CASE", "INSPIRED_BY_TRUE_EVENTS"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/claim"}
    },
    "source_subjects": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceSubject"}
    },
    "verified_events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/verifiedEvent"}
    },
    "source_truth_contract": {"$ref": "#/$defs/sourceTruthContractInput"},
    "source_disclosure": {"$ref": "#/$defs/sourceDisclosure"},
    "clinical_labels": {"$ref": "#/$defs/clinicalLabels"},
    "actor": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "submitted_at": {"type": "string", "format": "date-time"},
    "bound_input_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }
  },
  "$defs": {
    "canonicalId": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2,}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "url", "title", "publisher", "published_at", "source_type", "retrieved_at", "evidence_locator", "verification_actor", "verification_status"],
      "properties": {
        "source_id": {"$ref": "#/$defs/canonicalId"},
        "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "published_at": {"type": "string", "format": "date"},
        "source_type": {
          "enum": ["PRIMARY", "SECONDARY", "COURT_RECORD", "OFFICIAL_RECORD", "NEWS", "EXPERT_PUBLICATION"]
        },
        "retrieved_at": {"type": "string", "format": "date-time"},
        "evidence_locator": {"type": "string", "minLength": 1},
        "source_snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "archive_locator": {"type": "string", "minLength": 1},
        "verification_actor": {"type": "string", "minLength": 1},
        "verification_status": {"enum": ["VERIFIED", "REJECTED", "PENDING"]}
      },
      "oneOf": [
        {"required": ["source_snapshot_sha256"], "not": {"required": ["archive_locator"]}},
        {"required": ["archive_locator"], "not": {"required": ["source_snapshot_sha256"]}}
      ]
    },
    "sourceSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_subject_id", "pseudonym", "source_role", "related_fact_ids", "identity_disclosure_level"],
      "properties": {
        "source_subject_id": {"type": "string", "pattern": "^SUBJECT-[0-9]{2,}$"},
        "pseudonym": {"type": "string", "minLength": 1},
        "source_role": {"type": "string", "minLength": 1},
        "related_fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/canonicalId"}},
        "identity_disclosure_level": {"enum": ["PUBLIC", "PSEUDONYMIZED", "RESTRICTED"]}
      }
    },
    "verifiedRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_source_subject_id", "to_source_subject_id", "relationship_type", "source_claim_ids"],
      "properties": {
        "from_source_subject_id": {"type": "string", "pattern": "^SUBJECT-[0-9]{2,}$"},
        "to_source_subject_id": {"type": "string", "pattern": "^SUBJECT-[0-9]{2,}$"},
        "relationship_type": {"type": "string", "minLength": 1},
        "source_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/canonicalId"}}
      }
    },
    "verifiedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified_event_id", "statement", "sequence", "participant_source_subject_ids", "source_claim_ids"],
      "properties": {
        "verified_event_id": {"type": "string", "pattern": "^VEVT-[0-9]{2,}$"},
        "statement": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "setting": {"type": ["string", "null"]},
        "participant_source_subject_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SUBJECT-[0-9]{2,}$"}},
        "source_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/canonicalId"}}
      }
    },
    "sourceTruthContractInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locked_dimensions", "verified_relationships", "verified_incident_type", "verified_setting", "verified_responsible_agent_structure", "verified_legal_outcome", "flexible_dimensions", "unknown_dimensions", "source_claim_ids"],
      "properties": {
        "locked_dimensions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "verified_relationships": {"type": "array", "items": {"$ref": "#/$defs/verifiedRelationship"}},
        "verified_incident_type": {"type": ["string", "null"]},
        "verified_setting": {"type": ["string", "null"]},
        "verified_responsible_agent_structure": {"type": ["string", "null"]},
        "verified_legal_outcome": {"type": ["string", "null"]},
        "flexible_dimensions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "unknown_dimensions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/canonicalId"}}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "claim", "classification", "evidence_source_ids", "basis_fact_ids", "evidence_scope", "confidence", "presented_as_fact"],
      "properties": {
        "fact_id": {"$ref": "#/$defs/canonicalId"},
        "claim": {"type": "string", "minLength": 1},
        "classification": {"enum": ["FACT", "INFERENCE", "DRAMATIZATION"]},
        "evidence_source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/canonicalId"}
        },
        "basis_fact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/canonicalId"}
        },
        "evidence_scope": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "presented_as_fact": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"classification": {"const": "FACT"}}}, "then": {"properties": {"evidence_source_ids": {"minItems": 1}, "presented_as_fact": {"const": true}}}},
        {"if": {"properties": {"classification": {"const": "INFERENCE"}}}, "then": {"properties": {"basis_fact_ids": {"minItems": 1}}}},
        {"if": {"properties": {"classification": {"const": "DRAMATIZATION"}}}, "then": {"properties": {"presented_as_fact": {"const": false}}}}
      ]
    },
    "sourceDisclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_family",
        "schema_version",
        "project_id",
        "internal_mode",
        "audience_label_text"
      ],
      "properties": {
        "$schema": {"type": "string"},
        "schema_family": {"const": "source-disclosure"},
        "schema_version": {"const": "1.0.0"},
        "project_id": {"type": "string", "pattern": "^PRJ-[0-9]{3,}$"},
        "internal_mode": {
          "enum": ["VERIFIED_TRUE_CASE", "INSPIRED_BY_TRUE_EVENTS"]
        },
        "audience_label_text": {"type": "string", "minLength": 1}
      }
    },
    "clinicalLabels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_family", "schema_version", "project_id", "labels"],
      "properties": {
        "$schema": {"type": "string"},
        "schema_family": {"const": "clinical-labels"},
        "schema_version": {"const": "1.0.0"},
        "project_id": {"type": "string", "pattern": "^PRJ-[0-9]{3,}$"},
        "labels": {
          "type": "array",
          "items": {"$ref": "#/$defs/clinicalLabel"}
        }
      }
    },
    "clinicalLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term",
        "source_subject_id",
        "classification",
        "source_claim_ids",
        "qualified_expert",
        "documented_assessment"
      ],
      "properties": {
        "term": {"type": "string", "minLength": 1},
        "source_subject_id": {"type": "string", "pattern": "^SUBJECT-[0-9]{2,}$"},
        "classification": {
          "enum": [
            "CONFIRMED_DIAGNOSIS",
            "EXPERT_ASSESSMENT",
            "MEDIA_DESCRIPTION",
            "NARRATOR_OPINION",
            "UNVERIFIED_LABEL"
          ]
        },
        "source_claim_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2,}$"}
        },
        "qualified_expert": {"type": "boolean"},
        "documented_assessment": {"type": "boolean"}
      }
    }
  }
}
