{
  "$schema": "../schemas/runtime_task_catalog.schema.json",
  "schema_family": "runtime-task-catalog",
  "schema_version": "1.0.0",
  "tasks": {
    "project.compatibility": {
      "agent_id": "orchestrator",
      "executor": "CORE",
      "target_gate": "GATE-00",
      "reads": ["project_manifest", "production_config", "project_constraints"],
      "writes": ["compatibility_report"],
      "depends_on_tasks": [],
      "condition": {"always": true},
      "model_profile": null,
      "output_contract": "COMPATIBILITY_REPORT",
      "commit_policy": "ATOMIC_ON_PASS",
      "retry_policy": "CORE",
      "budget_profile": "SMALL",
      "standard_resources": ["STANDARD/compatibility_contract.json", "STANDARD/standard_defaults.json", "CHANNELS/mystery_main/channel_manifest.json"],
      "allowed_tools": [],
      "required_data_classes": ["INTERNAL"],
      "approval_required": false
    },
    "reference.sanitize_profile": {
      "agent_id": "reference_auditor",
      "executor": "CORE",
      "target_gate": "GATE-01",
      "reads": ["production_config"],
      "writes": ["reference_profile"],
      "depends_on_tasks": ["project.compatibility", "reference.intake_evidence"],
      "condition": {"always": true},
      "model_profile": null,
      "output_contract": "REFERENCE_PROFILE",
      "commit_policy": "ATOMIC_ON_PASS",
      "retry_policy": "CORE",
      "budget_profile": "SMALL",
      "standard_resources": ["STANDARD/reference_policy.json"],
      "allowed_tools": [],
      "required_data_classes": ["REFERENCE_RAW"],
      "approval_required": false
    },
    "reference.intake_evidence": {
      "agent_id": "reference_auditor",
      "executor": "CORE",
      "target_gate": "GATE-01",
      "reads": ["production_config"],
      "writes": ["sources", "claim_evidence", "source_case_brief", "verified_fact_ledger", "source_subjects", "verified_event_ledger", "source_truth_contract", "source_disclosure", "clinical_labels"],
      "depends_on_tasks": ["project.compatibility"],
      "condition": {"source_truth_in": ["VERIFIED_TRUE_CASE", "INSPIRED_BY_TRUE_EVENTS"]},
      "model_profile": null,
      "output_contract": "EVIDENCE_INTAKE_BUNDLE",
      "commit_policy": "ATOMIC_ON_PASS",
      "retry_policy": "CORE",
      "budget_profile": "SMALL",
      "standard_resources": ["STANDARD/reference_policy.json"],
      "allowed_tools": [],
      "required_data_classes": ["INTERNAL"],
      "approval_required": false
    },
    "variation.generate": {
      "agent_id": "variation_designer",
      "executor": "CORE",
      "target_gate": "GATE-01",
      "reads": ["production_config", "project_constraints"],
      "optional_reads": ["source_case_brief", "source_truth_contract"],
      "writes": ["variation_candidates"],
      "depends_on_tasks": ["project.compatibility", "reference.intake_evidence", "reference.sanitize_profile"],
      "condition": {"always": true},
      "model_profile": null,
      "output_contract": "VARIATION_CANDIDATES",
      "commit_policy": "ATOMIC_ON_PASS",
      "retry_policy": "CORE",
      "budget_profile": "SMALL",
      "standard_resources": ["STANDARD/variation_catalogs/registry.json", "STANDARD/variation_engines/registry.json"],
      "allowed_tools": [],
      "required_data_classes": ["INTERNAL"],
      "approval_required": false
    },
    "variation.elaborate_crime_events": {
      "agent_id": "variation_designer",
      "executor": "LLM",
      "target_gate": "GATE-01",
      "reads": ["production_config", "variation_candidates"],
      "optional_reads": ["verified_fact_ledger", "source_truth_contract"],
      "writes": ["candidate_event_briefs"],
      "depends_on_tasks": ["variation.generate"],
      "condition": {"capability_enabled": "EXPLICIT_CRIME_EVENT_POLICY"},
      "model_profile": "STRUCTURED_CREATIVE",
      "output_contract": "CANDIDATE_EVENT_BRIEFS",
      "commit_policy": "ATOMIC_ON_PASS",
      "retry_policy": "CREATIVE_STRUCTURED",
      "budget_profile": "MEDIUM",
      "standard_resources": ["STANDARD/schemas/candidate_event_briefs.schema.json", "CHANNELS/mystery_main/channel_manifest.json"],
      "allowed_tools": [],
      "required_data_classes": ["INTERNAL"],
      "approval_required": false
    },
    "novelty.variation_precheck": {
      "agent_id": "novelty_auditor",
      "executor": "CORE",
      "target_gate": "GATE-01",
      "reads": ["variation_candidates"],
      "optional_reads": ["candidate_event_briefs"],
      "writes": ["novelty_precheck"],
      "depends_on_tasks": ["variation.generate", "variation.elaborate_crime_events"],
      "condition": {"always": true},
      "model_profile": null,
      "output_contract": "NOVELTY_PRECHECK",
      "commit_policy": "ATOMIC_ON_PASS",
      "retry_policy": "CORE",
      "budget_profile": "SMALL",
      "standard_resources": ["STANDARD/novelty_thresholds.json", "STORY_LIBRARY/novelty_index.json"],
      "allowed_tools": [],
      "required_data_classes": ["INTERNAL"],
      "approval_required": false
    },
    "variation.evaluate": {
      "agent_id": "variation_designer",
      "executor": "LLM",
      "target_gate": "GATE-01",
      "reads": ["production_config", "reference_profile", "variation_candidates", "novelty_precheck", "candidate_eligibility"],
      "optional_reads": ["candidate_event_briefs"],
      "writes": ["candidate_evaluation"],
      "depends_on_tasks": ["variation.eligibility"],
      "condition": {"always": true},
      "model_profile": "STRUCTURED_CREATIVE",
      "output_contract": "CANDIDATE_EVALUATION",
      "commit_policy": "ATOMIC_ON_PASS",
      "retry_policy": "CREATIVE_STRUCTURED",
      "budget_profile": "MEDIUM",
      "standard_resources": ["STANDARD/mystery_production_standard_v1.3.md", "CHANNELS/mystery_main/channel_manifest.json"],
      "allowed_tools": [],
      "required_data_classes": ["INTERNAL", "REFERENCE_SANITIZED"],
      "approval_required": false
    },
    "variation.eligibility": {
      "agent_id": "orchestrator",
      "executor": "CORE",
      "target_gate": "GATE-01",
      "reads": ["production_config", "project_constraints", "compatibility_report", "variation_candidates", "novelty_precheck"],
      "optional_reads": ["candidate_event_briefs"],
      "writes": ["candidate_eligibility"],
      "depends_on_tasks": ["novelty.variation_precheck"],
      "condition": {"always": true},
      "model_profile": null,
      "output_contract": "CANDIDATE_ELIGIBILITY",
      "commit_policy": "ATOMIC_ON_PASS",
      "retry_policy": "CORE",
      "budget_profile": "SMALL",
      "standard_resources": ["CHANNELS/mystery_main/channel_manifest.json", "STANDARD/schemas/candidate_eligibility.schema.json"],
      "allowed_tools": [],
      "required_data_classes": ["INTERNAL"],
      "approval_required": false
    },
    "variation.approve": {
      "agent_id": "variation_designer",
      "executor": "CORE",
      "target_gate": "GATE-01",
      "reads": ["production_config", "variation_candidates", "novelty_precheck", "candidate_eligibility", "candidate_evaluation"],
      "optional_reads": ["candidate_event_briefs"],
      "writes": ["variation_candidates"],
      "depends_on_tasks": ["variation.evaluate"],
      "condition": {"always": true},
      "model_profile": null,
      "output_contract": "VARIATION_CANDIDATES",
      "commit_policy": "ATOMIC_ON_PASS",
      "retry_policy": "CORE",
      "budget_profile": "SMALL",
      "standard_resources": ["STANDARD/schemas/candidate_evaluation.schema.json", "STANDARD/schemas/candidate_eligibility.schema.json", "STANDARD/schemas/novelty_precheck.schema.json"],
      "allowed_tools": [],
      "required_data_classes": ["INTERNAL"],
      "approval_required": false
    },
    "variation.record_approval": {
      "agent_id": "orchestrator",
      "executor": "CORE",
      "target_gate": "GATE-01",
      "reads": ["production_config", "variation_candidates", "novelty_precheck", "candidate_eligibility", "candidate_evaluation"],
      "optional_reads": ["candidate_event_briefs"],
      "writes": ["candidate_approval"],
      "depends_on_tasks": ["variation.approve"],
      "condition": {"always": true},
      "model_profile": null,
      "output_contract": "CANDIDATE_APPROVAL",
      "commit_policy": "ATOMIC_ON_PASS",
      "retry_policy": "CORE",
      "budget_profile": "SMALL",
      "standard_resources": ["STANDARD/schemas/candidate_approval.schema.json"],
      "allowed_tools": [],
      "required_data_classes": ["INTERNAL"],
      "approval_required": false
    },
    "story.design_dna": {
      "agent_id": "story_architect",
      "executor": "LLM",
      "target_gate": "GATE-02",
      "reads": ["production_config", "reference_profile", "variation_candidates", "candidate_evaluation", "candidate_eligibility", "candidate_approval"],
      "optional_reads": ["candidate_event_briefs", "verified_fact_ledger", "source_truth_contract"],
      "writes": ["story_dna"],
      "depends_on_tasks": ["variation.record_approval"],
      "condition": {"always": true},
      "model_profile": "STRUCTURED_CREATIVE",
      "output_contract": "STORY_DNA_BUNDLE",
      "commit_policy": "ATOMIC_ON_PASS",
      "retry_policy": "CREATIVE_STRUCTURED",
      "budget_profile": "MEDIUM",
      "standard_resources": ["STANDARD/mystery_production_standard_v1.3.md", "CHANNELS/mystery_main/channel_manifest.json"],
      "allowed_tools": [],
      "required_data_classes": ["INTERNAL", "REFERENCE_SANITIZED"],
      "approval_required": false
    },
    "story.define_case": {
      "agent_id": "story_architect",
      "executor": "LLM",
      "target_gate": "GATE-03",
      "reads": ["production_config", "story_dna"],
      "optional_reads": ["candidate_event_briefs", "variation_candidates", "verified_fact_ledger", "source_truth_contract"],
      "writes": ["case_input", "facts"],
      "depends_on_tasks": ["story.design_dna"],
      "condition": {"always": true},
      "model_profile": "STRUCTURED_CREATIVE",
      "output_contract": "CASE_BUNDLE",
      "commit_policy": "ATOMIC_ON_PASS",
      "retry_policy": "CREATIVE_STRUCTURED",
      "budget_profile": "MEDIUM",
      "standard_resources": ["STANDARD/mystery_production_standard_v1.3.md", "CHANNELS/mystery_main/channel_manifest.json"],
      "allowed_tools": [],
      "required_data_classes": ["INTERNAL"],
      "approval_required": false
    },
    "story.define_crime_psychology": {
      "agent_id": "story_architect",
      "executor": "LLM",
      "target_gate": "GATE-03",
      "reads": ["production_config", "story_dna", "case_input", "facts"],
      "writes": ["crime_psychology"],
      "depends_on_tasks": ["story.define_case"],
      "condition": {"capability_enabled": "CRIME_PSYCHOLOGY_POLICY"},
      "model_profile": "STRUCTURED_CREATIVE",
      "output_contract": "CRIME_PSYCHOLOGY_BUNDLE",
      "commit_policy": "ATOMIC_ON_PASS",
      "retry_policy": "CREATIVE_STRUCTURED",
      "budget_profile": "SMALL",
      "standard_resources": ["STANDARD/mystery_production_standard_v1.3.md", "CHANNELS/mystery_main/channel_manifest.json"],
      "allowed_tools": [],
      "required_data_classes": ["INTERNAL"],
      "approval_required": false
    },
    "reference.initialize_fiction_evidence": {
      "agent_id": "reference_auditor",
      "executor": "CORE",
      "target_gate": "GATE-03",
      "reads": ["production_config", "case_input", "facts"],
      "writes": ["sources", "claim_evidence"],
      "depends_on_tasks": ["story.define_case"],
      "condition": {"source_truth_in": ["ORIGINAL_FICTION"]},
      "model_profile": null,
      "output_contract": "EVIDENCE_BUNDLE",
      "commit_policy": "ATOMIC_ON_PASS",
      "retry_policy": "CORE",
      "budget_profile": "SMALL",
      "standard_resources": ["STANDARD/reference_policy.json"],
      "allowed_tools": [],
      "required_data_classes": ["INTERNAL"],
      "approval_required": false
    },
    "reference.build_source_disclosure": {
      "agent_id": "reference_auditor",
      "executor": "CORE",
      "target_gate": "GATE-03",
      "reads": ["production_config", "sources", "claim_evidence"],
      "writes": ["source_disclosure"],
      "depends_on_tasks": ["reference.initialize_fiction_evidence"],
      "condition": {"all": [{"source_truth_in": ["ORIGINAL_FICTION"]}, {"capability_enabled": "SOURCE_DISCLOSURE_POLICY"}]},
      "model_profile": null,
      "output_contract": "SOURCE_DISCLOSURE_BUNDLE",
      "commit_policy": "ATOMIC_ON_PASS",
      "retry_policy": "CORE",
      "budget_profile": "SMALL",
      "standard_resources": ["STANDARD/reference_policy.json"],
      "allowed_tools": [],
      "required_data_classes": ["INTERNAL"],
      "approval_required": false
    },
    "reference.build_clinical_labels": {
      "agent_id": "reference_auditor",
      "executor": "CORE",
      "target_gate": "GATE-03",
      "reads": ["production_config", "sources", "claim_evidence"],
      "writes": ["clinical_labels"],
      "depends_on_tasks": ["reference.initialize_fiction_evidence"],
      "condition": {"all": [{"source_truth_in": ["ORIGINAL_FICTION"]}, {"capability_enabled": "CLINICAL_LABEL_POLICY"}]},
      "model_profile": null,
      "output_contract": "CLINICAL_LABEL_BUNDLE",
      "commit_policy": "ATOMIC_ON_PASS",
      "retry_policy": "CORE",
      "budget_profile": "SMALL",
      "standard_resources": ["STANDARD/reference_policy.json"],
      "allowed_tools": [],
      "required_data_classes": ["INTERNAL"],
      "approval_required": false
    },
    "character.design": {
      "agent_id": "character_designer",
      "executor": "LLM",
      "target_gate": "GATE-04",
      "reads": ["case_input", "story_dna", "facts"],
      "optional_reads": ["candidate_event_briefs", "variation_candidates", "source_subjects", "source_truth_contract", "project_constraints"],
      "writes": ["characters", "relationships", "knowledge_matrix"],
      "depends_on_tasks": ["reference.intake_evidence", "reference.initialize_fiction_evidence", "reference.build_source_disclosure", "reference.build_clinical_labels"],
