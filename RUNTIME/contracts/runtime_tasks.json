      "optional_reads": ["source_truth_contract"],
      "writes": ["crime_event_contract"],
      "depends_on_tasks": ["character.design"],
      "condition": {"capability_enabled": "EXPLICIT_CRIME_EVENT_POLICY"},
      "model_profile": null,
      "output_contract": "CRIME_EVENT_CONTRACT",
      "commit_policy": "ATOMIC_ON_PASS",
      "retry_policy": "CORE",
      "budget_profile": "SMALL",
      "standard_resources": ["STANDARD/schemas/crime_event_contract.schema.json", "STANDARD/schemas/candidate_event_briefs.schema.json"],
