{
  "$schema": "../../STANDARD/schemas/channel_dna.schema.json",
  "schema_family": "channel-dna",
  "schema_version": "1.0.0",
  "content_version": "2.1.0",
  "channel_id": "MYSTERY_MAIN",
  "identity": {
    "statement": "살인·납치·감금·폭행·스토킹·주거침입·교제폭력·가정폭력 등 구체적인 대인범죄 사건을 피해자·목격자·연루자의 시점으로 재연하고, 주관적 내레이션과 외부 패널의 감정 반응·용의자 추적을 교차시켜 후반에 범인, 범행 동기, 범행 방식과 피해 결과를 공개하는 범죄사건 재연·추적 예능 채널이다.",
    "subhead": "살인·납치·감금·폭행 사건을 재연하고 패널과 함께 전모를 추적한다",
    "keywords": [
      "GROUNDED",
      "EXPLICIT_INTERPERSONAL_CRIME",
      "CRIME_REENACTMENT",
      "VICTIM_WITNESS_INVOLVED_POV",
      "SUBJECTIVE_NARRATION",
      "PANEL_PURSUIT",
      "LATE_CASE_REVEAL"
    ]
  },
  "capabilities": {
    "GENRE_POLICY": {
      "allowed_genres": ["CRIME_EVENT_THRILLER", "CRIME_REENACTMENT_THRILLER", "CRIME_THRILLER"],
      "adjacent_genres": ["THRILLER", "SUSPENSE", "CRIME_MYSTERY"],
      "realism": "GROUNDED",
      "primary_story_engine": "EXPLICIT_INTERPERSONAL_CRIME_EVENT",
      "mystery_engine_priority": "SUPPORTING_PURSUIT",
      "prohibited_resolutions": ["UNEXPLAINED_SUPERNATURAL_FORCE", "MAGIC_DEPENDENT_REVEAL", "PSYCHIC_DEDUCTION"]
    },
    "TONE_POLICY": {
      "primary_tones": ["GROUNDED", "SUSPENSEFUL", "VICTIM_CENTERED"],
      "prohibited_tones": ["DETACHED_LECTURE", "VICTIM_BLAMING", "GRAPHIC_EXPLOITATION"]
    },
    "PRESENTATION_POLICY": {
      "modes": ["DRAMA", "NARRATION", "PANEL_REACTION"],
      "audience_position": "WITNESS",
      "information_cycle": ["CRIME_EVENT_REENACTMENT", "SUBJECTIVE_NARRATION", "EMOTIONAL_REACTION", "SUSPECT_PURSUIT", "LATE_CASE_REVEAL"],
      "mechanical_cycle_repetition": false
    },
    "AUDIENCE_CONTRACT": {
      "fair_play": true,
      "promises": [
        "구체적인 대인범죄 사건의 행동과 피해 인과를 재연한다.",
        "주관적 내레이션은 사건 내부 인물의 감정·오해·기억을 전달한다.",
        "외부 패널은 감정 반응과 수상 행동·용의자 추적·의견 수정을 수행한다.",
        "후반에 범인, 동기, 방식과 피해 결과를 공개한다."
      ]
    },
    "STORY_VARIATION_POLICY": {
      "fixed_dimensions": ["CHANNEL_IDENTITY", "EXPLICIT_CRIME_EVENT", "VICTIM_DIGNITY", "LATE_CASE_REVEAL"],
      "variable_dimensions": ["INCIDENT_TYPE", "CORE_ACTION_TYPE", "RELATIONSHIP_CONTEXT", "HARM_CLASSIFICATION", "MOTIVE_CATEGORY", "PROTAGONIST_GOAL", "PROTAGONIST_RISK", "DEPICTION_MODE", "REVEAL_STRUCTURE"],
      "generation_order": ["INCIDENT_TYPE", "CORE_ACTION_TYPE", "RELATIONSHIP_CONTEXT", "HARM_CLASSIFICATION", "MOTIVE_CATEGORY", "PROTAGONIST_GOAL", "PROTAGONIST_RISK", "DEPICTION_MODE", "REVEAL_STRUCTURE"],
      "minimum_candidates": 5,
      "compare_recent_projects": [5, 10]
    },
    "NARRATION_POLICY": {
      "enabled": true,
      "purposes": ["CHARACTER_SUBJECTIVITY", "EMOTIONAL_CONTINUITY", "MEMORY_LIMITATION", "TIME_COMPRESSION"],
      "repeat_visible_information": false,
      "premature_fact_or_clue_reference": false
    },
    "REACTION_POLICY": {
      "enabled": true,
      "target_ratio": {"min": 0.1, "max": 0.3},
      "functions": ["EMOTIONAL_REACTION", "ANOMALY_DETECTION", "HYPOTHESIS_GENERATION", "SUSPECT_DISCUSSION", "HYPOTHESIS_REVISION", "CONTRADICTION_DETECTION", "MORAL_REACTION", "TENSION_RELEASE", "EXPECTATION_BUILDING", "RISK_SIGNAL_RECOGNITION", "VICTIM_CONTEXTUALIZATION", "BELIEF_CORRECTION"],
      "required_functions": ["EMOTIONAL_REACTION"],
      "required_function_any_of": ["ANOMALY_DETECTION", "SUSPECT_DISCUSSION", "HYPOTHESIS_REVISION", "BELIEF_CORRECTION"]
    },
    "RETENTION_POLICY": {
      "mode": "CASE_REENACTMENT_AND_PURSUIT",
      "required_functions": ["EVENT_ENTRY", "RISK_ESCALATION", "PURSUIT_UPDATE", "LATE_CASE_REVEAL"],
      "fixed_stage_order": false
    },
    "VICTIM_CENTERED_POLICY": {
      "enabled": true,
      "require_agency_outcome": false,
      "require_responsible_agent_payoff": true,
      "prohibited_phrases": ["피해자가 자초했다", "피해자도 잘못했다", "왜 떠나지 않았나"]
    },
    "SOURCE_DISCLOSURE_POLICY": {
      "enabled": true,
      "labels_by_source_truth": {
        "ORIGINAL_FICTION": "ORIGINAL_FICTION",
        "VERIFIED_TRUE_CASE": "VERIFIED_TRUE_CASE",
        "INSPIRED_BY_TRUE_EVENTS": "INSPIRED_BY_TRUE_EVENTS"
      }
    },
    "EXPLICIT_CRIME_EVENT_POLICY": {
      "enabled": true,
      "core_crimes": ["MURDER", "KIDNAPPING", "CONFINEMENT", "ASSAULT", "STALKING", "HOME_INVASION", "DATING_VIOLENCE", "DOMESTIC_VIOLENCE"],
      "require_central_event": true,
      "allow_overlapping_crimes": true,
      "method_detail_level": "NON_ACTIONABLE_SUMMARY_ONLY",
      "required_reveal_targets": ["CULPRIT", "MOTIVE", "METHOD", "HARM_RESULT"],
      "development_functions_by_family": {
        "MURDER": ["HARM_OR_DANGER_RECOGNITION", "INVOLVEMENT_OR_SUSPICION", "MOTIVE_AND_RESPONSIBILITY", "EVENT_RECONSTRUCTION"],
        "LIBERTY_CRIME": ["LIBERTY_DEPRIVATION", "THREAT_AND_CHOICE_CONSTRAINT", "RESPONSE_OR_DISCOVERY", "HARM_OUTCOME"],
        "RELATIONAL_VIOLENCE": ["VIOLENCE_OR_THREAT", "RELATIONSHIP_AND_POWER", "RESPONSE_BARRIER", "VIOLENCE_OUTCOME"],
        "ACCESS_CRIME": ["REPEATED_ACCESS_OR_INTRUSION", "SAFETY_COLLAPSE", "SAFETY_RESPONSE", "OFFENDER_RESPONSIBILITY"]
      },
      "nonlinear_development_allowed": true,
      "require_survival": false,
      "require_direct_reporting": false,
      "require_forgiveness": false,
      "require_recovery": false
    }
  }
}
