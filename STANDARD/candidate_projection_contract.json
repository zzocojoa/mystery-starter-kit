{
  "$schema": "./schemas/candidate_projection_contract.schema.json",
  "schema_family": "candidate-projection-contract",
  "schema_version": "1.0.0",
  "dimensions": {
    "genre": {"classification": "NON_PROJECTABLE", "reason": "production_config.genre로 고정하며 자유 Variation으로 사용하지 않습니다."},
    "mystery_type": {"classification": "PROJECTED", "targets": [{"artifact": "story_dna", "json_path": "story_dna.mystery_type", "match": "EQUALS"}]},
    "architecture": {"classification": "PROJECTED", "targets": [{"artifact": "story_dna", "json_path": "story_dna.architecture", "match": "EQUALS"}]},
    "protagonist_role": {"classification": "PROJECTED", "targets": [{"artifact": "story_dna", "json_path": "story_dna.protagonist_role", "match": "EQUALS"}]},
    "perspective": {"classification": "PROJECTED", "targets": [{"artifact": "story_dna", "json_path": "story_dna.perspective", "match": "EQUALS"}]},
    "timeline_style": {"classification": "PROJECTED", "targets": [{"artifact": "story_dna", "json_path": "story_dna.timeline_style", "match": "EQUALS"}]},
    "incident_type": {"classification": "PROJECTED", "targets": [{"artifact": "story_dna", "json_path": "story_dna.incident_type", "match": "EQUALS"}, {"artifact": "case_input", "json_path": "incident_type", "match": "EQUALS"}, {"artifact": "crime_event_contract", "json_path": "primary_crime", "match": "EQUALS"}]},
    "core_action_type": {"classification": "PROJECTED", "targets": [{"artifact": "crime_event_contract", "json_path": "core_action_type", "match": "EQUALS"}]},
    "relationship_context": {"classification": "PROJECTED", "targets": [{"artifact": "crime_event_contract", "json_path": "relationship_context", "match": "EQUALS"}]},
    "harm_classification": {"classification": "PROJECTED", "targets": [{"artifact": "crime_event_contract", "json_path": "harm_classifications", "match": "CONTAINS"}]},
    "motive_category": {"classification": "ADVISORY", "reason": "동기 Category는 사건 계약의 구체적인 motive 문장으로 전개하며 의미 검토에서 확인합니다."},
    "protagonist_goal": {"classification": "PROJECTED", "targets": [{"artifact": "crime_event_contract", "json_path": "protagonist_goal", "match": "EQUALS"}]},
    "protagonist_risk": {"classification": "PROJECTED", "targets": [{"artifact": "crime_event_contract", "json_path": "protagonist_risk", "match": "EQUALS"}]},
    "depiction_mode": {"classification": "PROJECTED", "targets": [{"artifact": "crime_event_contract", "json_path": "depiction_mode", "match": "EQUALS"}]},
    "reveal_structure": {"classification": "ADVISORY", "reason": "공개 구조는 네 Reveal Target의 planned_phase 및 Segment 배치로 재검증합니다."},
    "setting": {"classification": "PROJECTED", "targets": [{"artifact": "story_dna", "json_path": "story_dna.setting", "match": "EQUALS"}, {"artifact": "case_input", "json_path": "setting", "match": "EQUALS"}]},
    "culprit_structure": {"classification": "PROJECTED", "targets": [{"artifact": "story_dna", "json_path": "story_dna.culprit_structure", "match": "EQUALS"}]},
    "primary_twist": {"classification": "PROJECTED", "targets": [{"artifact": "story_dna", "json_path": "story_dna.primary_twist", "match": "EQUALS"}]},
    "relationship_engine": {"classification": "PROJECTED", "targets": [{"artifact": "story_dna", "json_path": "story_dna.relationship_engine.primary", "match": "EQUALS"}]},
    "pressure_engine": {"classification": "PROJECTED", "targets": [{"artifact": "story_dna", "json_path": "story_dna.pressure_engine.source", "match": "EQUALS"}]},
    "dramatic_engine": {"classification": "PROJECTED", "targets": [{"artifact": "story_dna", "json_path": "story_dna.dramatic_engine.primary", "match": "EQUALS"}]},
    "information_mechanism": {"classification": "PROJECTED", "targets": [{"artifact": "story_dna", "json_path": "story_dna.information_mechanism", "match": "CONTAINS"}]},
    "clue_mechanism": {"classification": "PROJECTED", "targets": [{"artifact": "story_dna", "json_path": "story_dna.clue_mechanism", "match": "CONTAINS"}]},
    "reveal_mode": {"classification": "PROJECTED", "targets": [{"artifact": "story_dna", "json_path": "story_dna.reveal_mode", "match": "EQUALS"}]},
    "threat_type": {"classification": "PROJECTED", "targets": [{"artifact": "crime_psychology", "json_path": "threat_type", "match": "EQUALS"}]},
    "trusted_domain": {"classification": "PROJECTED", "targets": [{"artifact": "crime_psychology", "json_path": "trusted_domain", "match": "EQUALS"}]},
    "safe_domain_betrayal": {"classification": "PROJECTED", "targets": [{"artifact": "crime_psychology", "json_path": "safe_domain_betrayal", "match": "EQUALS"}]},
    "responsible_agent_structure": {"classification": "PROJECTED", "targets": [{"artifact": "crime_psychology", "json_path": "responsible_agent_structure", "match": "EQUALS"}]},
    "victim_agency_mode": {"classification": "PROJECTED", "targets": [{"artifact": "crime_psychology", "json_path": "victim_agency_mode", "match": "EQUALS"}]},
    "episode_theme": {"classification": "PROJECTED", "targets": [{"artifact": "crime_psychology", "json_path": "episode_theme", "match": "EQUALS"}]},
    "final_proof_mechanism": {"classification": "PROJECTED", "targets": [{"artifact": "clue_matrix", "json_path": "final_proof_mechanism", "match": "EQUALS"}]},
    "technical_dependency_level": {"classification": "PROJECTED", "targets": [{"artifact": "clue_matrix", "json_path": "technical_dependency_level", "match": "EQUALS"}]},
    "production_complexity": {"classification": "ADVISORY", "reason": "Project Production Limit에서 강제합니다."},
    "location_count": {"classification": "ADVISORY", "reason": "Actual Timeline의 고유 장소 수로 재검증합니다."},
    "major_character_count": {"classification": "ADVISORY", "reason": "Characters Artifact의 실제 인물 수로 재검증합니다."},
    "special_effect_level": {"classification": "ADVISORY", "reason": "Project Production Limit에서 강제합니다."},
    "child_actor_use": {"classification": "ADVISORY", "reason": "Project Production Limit에서 강제합니다."},
    "vehicle_scene": {"classification": "ADVISORY", "reason": "Project Production Limit에서 강제합니다."},
    "graphic_violence": {"classification": "ADVISORY", "reason": "Project Production Limit에서 강제합니다."}
  }
}
