{
  "$schema": "./schemas/dependency_graph.schema.json",
  "schema_family": "dependency-graph",
  "schema_version": "1.0.0",
  "artifacts": {
    "project_manifest": {
      "path": "00_PROJECT/project_manifest.json",
      "depends_on": [],
      "owner_agent": "orchestrator"
    },
    "compatibility_report": {
      "path": "00_PROJECT/compatibility_report.json",
      "depends_on": ["project_manifest"],
      "owner_agent": "orchestrator"
    },
    "production_config": {
      "path": "00_PROJECT/production_config.json",
      "depends_on": ["project_manifest", "compatibility_report"],
      "owner_agent": "orchestrator"
    },
    "broadcast_readable_config": {
      "path": "00_PROJECT/broadcast_readable_config.json",
      "depends_on": ["project_manifest", "compatibility_report"],
      "owner_agent": "orchestrator",
      "required_when": {"artifact_exists": "broadcast_readable_config"}
    },
    "project_constraints": {
      "path": "00_PROJECT/project_constraints.json",
      "depends_on": ["project_manifest", "compatibility_report"],
      "owner_agent": "orchestrator"
    },
    "reference_profile": {
      "path": "00_PROJECT/reference_profile.json",
      "depends_on": ["production_config"],
      "owner_agent": "reference_auditor"
    },
    "source_case_brief": {
      "path": "01_CASE/source_case_brief.json",
      "depends_on": ["production_config"],
      "owner_agent": "reference_auditor",
      "required_when": {"source_truth_in": ["VERIFIED_TRUE_CASE", "INSPIRED_BY_TRUE_EVENTS"]}
    },
    "verified_fact_ledger": {
      "path": "01_CASE/verified_fact_ledger.json",
      "depends_on": ["source_case_brief"],
      "owner_agent": "reference_auditor",
      "required_when": {"source_truth_in": ["VERIFIED_TRUE_CASE", "INSPIRED_BY_TRUE_EVENTS"]}
    },
    "source_subjects": {
      "path": "01_CASE/source_subjects.json",
      "depends_on": ["production_config"],
      "owner_agent": "reference_auditor",
      "required_when": {"source_truth_in": ["VERIFIED_TRUE_CASE", "INSPIRED_BY_TRUE_EVENTS"]}
    },
    "verified_event_ledger": {
      "path": "01_CASE/verified_event_ledger.json",
      "depends_on": ["source_subjects", "verified_fact_ledger"],
      "owner_agent": "reference_auditor",
      "required_when": {"source_truth_in": ["VERIFIED_TRUE_CASE", "INSPIRED_BY_TRUE_EVENTS"]}
    },
    "source_truth_contract": {
      "path": "01_CASE/source_truth_contract.json",
      "depends_on": ["sources", "claim_evidence", "verified_fact_ledger", "source_subjects", "verified_event_ledger"],
      "owner_agent": "reference_auditor",
      "required_when": {"source_truth_in": ["VERIFIED_TRUE_CASE", "INSPIRED_BY_TRUE_EVENTS"]}
    },
    "variation_candidates": {
      "path": "00_PROJECT/variation_candidates.json",
      "depends_on": ["production_config", "project_constraints", "reference_profile", "source_case_brief", "source_truth_contract"],
      "owner_agent": "variation_designer"
    },
    "candidate_event_briefs": {
      "path": "00_PROJECT/candidate_event_briefs.json",
      "depends_on": ["production_config", "variation_candidates", "source_truth_contract", "verified_fact_ledger"],
      "owner_agent": "variation_designer",
      "required_when": {"capability_enabled": "EXPLICIT_CRIME_EVENT_POLICY"}
    },
    "candidate_evaluation": {
      "path": "00_PROJECT/candidate_evaluation.json",
      "depends_on": ["production_config", "variation_candidates", "candidate_event_briefs", "novelty_precheck", "candidate_eligibility"],
      "owner_agent": "variation_designer"
    },
    "candidate_approval": {
      "path": "00_PROJECT/candidate_approval.json",
      "depends_on": ["variation_candidates", "candidate_event_briefs", "novelty_precheck", "candidate_eligibility", "candidate_evaluation"],
      "owner_agent": "orchestrator"
    },
    "novelty_precheck": {
      "path": "08_QA/novelty_precheck.json",
      "depends_on": ["variation_candidates", "candidate_event_briefs"],
      "owner_agent": "novelty_auditor"
    },
    "candidate_eligibility": {
      "path": "08_QA/candidate_eligibility.json",
      "depends_on": ["production_config", "project_constraints", "compatibility_report", "variation_candidates", "candidate_event_briefs", "novelty_precheck"],
      "owner_agent": "orchestrator"
    },
    "story_dna": {
      "path": "00_PROJECT/story_dna.json",
      "depends_on": ["reference_profile", "verified_fact_ledger", "source_truth_contract", "variation_candidates", "candidate_event_briefs", "candidate_evaluation", "candidate_eligibility", "candidate_approval", "novelty_precheck"],
      "owner_agent": "story_architect"
    },
    "story_fingerprint": {
      "path": "00_PROJECT/story_fingerprint.json",
      "depends_on": ["story_dna", "beat_sheet", "causal_graph"],
      "owner_agent": "novelty_auditor"
    },
    "case_input": {
      "path": "01_CASE/case_input.json",
      "depends_on": ["story_dna", "variation_candidates", "candidate_event_briefs", "source_truth_contract"],
      "owner_agent": "story_architect"
    },
    "facts": {
      "path": "01_CASE/facts.json",
      "depends_on": ["case_input"],
      "owner_agent": "story_architect"
    },
    "crime_event_contract": {
      "path": "01_CASE/crime_event_contract.json",
      "depends_on": ["production_config", "variation_candidates", "candidate_event_briefs", "candidate_approval", "story_dna", "case_input", "facts", "characters", "relationships", "source_truth_contract"],
      "owner_agent": "story_architect",
      "required_when": {"capability_enabled": "EXPLICIT_CRIME_EVENT_POLICY"}
    },
    "crime_psychology": {
      "path": "01_CASE/crime_psychology.json",
      "depends_on": ["case_input", "facts", "story_dna"],
      "owner_agent": "story_architect",
      "required_when": {"capability_enabled": "CRIME_PSYCHOLOGY_POLICY"}
    },
    "sources": {
      "path": "01_CASE/sources.json",
      "depends_on": ["production_config", "source_case_brief"],
      "owner_agent": "reference_auditor"
    },
    "claim_evidence": {
      "path": "01_CASE/claim_evidence.json",
      "depends_on": ["sources", "verified_fact_ledger"],
      "owner_agent": "reference_auditor"
    },
    "source_disclosure": {
      "path": "01_CASE/source_disclosure.json",
      "depends_on": ["production_config", "sources", "source_case_brief"],
      "owner_agent": "reference_auditor",
      "required_when": {"any": [{"source_truth_in": ["VERIFIED_TRUE_CASE", "INSPIRED_BY_TRUE_EVENTS"]}, {"capability_enabled": "SOURCE_DISCLOSURE_POLICY"}]}
    },
    "clinical_labels": {
      "path": "01_CASE/clinical_labels.json",
      "depends_on": ["production_config", "claim_evidence", "source_subjects"],
      "owner_agent": "reference_auditor",
      "required_when": {"any": [{"source_truth_in": ["VERIFIED_TRUE_CASE", "INSPIRED_BY_TRUE_EVENTS"]}, {"capability_enabled": "CLINICAL_LABEL_POLICY"}]}
    },
    "characters": {
      "path": "02_CHARACTER/characters.json",
      "depends_on": ["case_input", "story_dna", "variation_candidates", "candidate_event_briefs", "source_subjects", "source_truth_contract"],
      "owner_agent": "character_designer"
    },
    "relationships": {
      "path": "02_CHARACTER/relationships.json",
      "depends_on": ["characters", "story_dna"],
      "owner_agent": "character_designer"
    },
    "knowledge_matrix": {
      "path": "02_CHARACTER/knowledge_matrix.json",
      "depends_on": ["characters", "facts"],
      "owner_agent": "character_designer"
    },
    "actual_timeline": {
      "path": "03_TIMELINE/actual_timeline.json",
      "depends_on": ["case_input", "crime_event_contract", "characters", "verified_event_ledger", "source_truth_contract"],
      "owner_agent": "mystery_designer"
    },
    "viewer_timeline": {
      "path": "03_TIMELINE/viewer_timeline.json",
      "depends_on": ["actual_timeline", "crime_event_contract", "knowledge_matrix"],
      "owner_agent": "mystery_designer"
    },
    "audience_belief": {
      "path": "03_TIMELINE/audience_belief_timeline.json",
      "depends_on": ["viewer_timeline", "story_dna"],
      "owner_agent": "mystery_designer"
    },
    "clue_matrix": {
      "path": "04_MYSTERY/clue_matrix.json",
      "depends_on": ["actual_timeline", "viewer_timeline"],
      "owner_agent": "mystery_designer"
    },
    "hypothesis_ledger": {
      "path": "04_MYSTERY/hypothesis_ledger.json",
      "depends_on": ["clue_matrix", "audience_belief"],
      "owner_agent": "mystery_designer"
    },
    "causal_graph": {
      "path": "04_MYSTERY/causal_graph.json",
      "depends_on": ["actual_timeline", "crime_event_contract", "facts"],
      "owner_agent": "mystery_designer"
    },
    "beat_sheet": {
      "path": "05_STORY/beat_sheet.json",
      "depends_on": ["story_dna", "viewer_timeline", "clue_matrix"],
      "owner_agent": "story_architect"
    },
    "retention_plan": {
      "path": "05_STORY/retention_plan.json",
      "depends_on": ["beat_sheet", "audience_belief"],
      "owner_agent": "story_architect"
    },
    "psychological_arc": {
      "path": "05_STORY/psychological_arc.json",
      "depends_on": ["story_dna", "crime_psychology", "characters", "beat_sheet"],
      "owner_agent": "story_architect",
      "required_when": {"all": [{"channel_version_at_least": "2.1.0"}, {"capability_enabled": "SCENE_REALIZATION_POLICY"}, {"not": {"config_equals": ["script_source_mode", "SCREENPLAY_UNITS"]}}]}
    },
    "character_state_transitions": {
      "path": "05_STORY/character_state_transitions.json",
      "depends_on": ["production_config", "story_dna", "crime_event_contract", "characters", "facts", "beat_sheet", "clue_matrix", "scene_cards"],
      "owner_agent": "story_architect",
      "required_when": {"all": [{"config_equals": ["script_source_mode", "SCREENPLAY_UNITS"]}, {"capability_enabled": "EXPLICIT_CRIME_EVENT_POLICY"}]}
    },
    "scene_cards": {
      "path": "06_SCENE/scene_cards.json",
      "depends_on": ["beat_sheet", "retention_plan", "psychological_arc", "crime_event_contract", "clue_matrix"],
      "owner_agent": "scene_designer"
    },
    "production_footprint": {
      "path": "06_SCENE/production_footprint.json",
      "depends_on": ["project_constraints", "variation_candidates", "characters", "actual_timeline", "scene_cards"],
      "owner_agent": "scene_designer",
      "required_when": {"production_footprint_enforced": true}
    },
    "panel_cast": {
      "path": "06_SCENE/panel_cast.json",
      "depends_on": ["production_config"],
      "owner_agent": "scene_designer"
    },
    "reaction_segments": {
      "path": "06_SCENE/reaction_segments.json",
      "depends_on": ["scene_cards", "audience_belief", "clue_matrix", "hypothesis_ledger", "panel_cast"],
      "owner_agent": "scene_designer"
    },
    "presentation_plan": {
      "path": "06_SCENE/presentation_plan.json",
      "depends_on": ["scene_cards", "psychological_arc", "character_state_transitions", "crime_event_contract", "production_config", "panel_cast", "reaction_segments"],
      "owner_agent": "scene_designer"
    },
    "expert_segments": {
      "path": "06_SCENE/expert_segments.json",
      "depends_on": ["scene_cards", "presentation_plan", "claim_evidence", "crime_psychology"],
      "owner_agent": "scene_designer",
      "required_when": {"all": [{"capability_enabled": "EXPERT_ANALYSIS_POLICY"}, {"source_truth_in": ["VERIFIED_TRUE_CASE", "INSPIRED_BY_TRUE_EVENTS"]}]}
    },
    "drama_script": {
      "path": "07_SCRIPT/drama_script.md",
      "depends_on": ["screenplay_units", "scene_cards", "crime_event_contract", "knowledge_matrix", "clue_matrix"],
      "owner_agent": "script_writer"
    },
    "narration_script": {
      "path": "07_SCRIPT/narration_script.md",
      "depends_on": ["screenplay_units", "scene_cards", "viewer_timeline", "audience_belief"],
      "owner_agent": "script_writer"
    },
    "panel_reaction_script": {
      "path": "07_SCRIPT/panel_reaction_script.md",
      "depends_on": ["screenplay_units", "reaction_segments", "panel_cast", "clue_matrix", "viewer_timeline"],
      "owner_agent": "script_writer"
    },
    "expert_analysis_script": {
      "path": "07_SCRIPT/expert_analysis_script.md",
      "depends_on": ["expert_segments", "presentation_plan", "claim_evidence"],
      "owner_agent": "script_writer",
      "required_when": {"all": [{"capability_enabled": "EXPERT_ANALYSIS_POLICY"}, {"source_truth_in": ["VERIFIED_TRUE_CASE", "INSPIRED_BY_TRUE_EVENTS"]}, {"artifact_status": ["expert_segments", "PLANNED"]}]}
    },
    "screenplay_units": {
      "path": "07_SCRIPT/screenplay_units.json",
      "depends_on": ["production_config", "crime_event_contract", "characters", "relationships", "knowledge_matrix", "actual_timeline", "viewer_timeline", "audience_belief", "clue_matrix", "character_state_transitions", "scene_cards", "presentation_plan"],
      "owner_agent": "script_writer",
      "required_when": {"config_equals": ["script_source_mode", "SCREENPLAY_UNITS"]}
    },
    "draft_script": {
      "path": "07_SCRIPT/draft_v01.md",
      "depends_on": ["screenplay_units", "drama_script", "narration_script", "panel_reaction_script", "expert_analysis_script", "presentation_plan", "source_disclosure"],
      "owner_agent": "script_writer"
    },
    "final_script": {
      "path": "07_SCRIPT/final_script.md",
      "depends_on": ["draft_script", "presentation_plan"],
      "owner_agent": "script_writer"
    },
    "broadcast_readable_script": {
      "path": "07_SCRIPT/broadcast_readable_script.md",
      "depends_on": ["production_config", "broadcast_readable_config", "screenplay_units", "characters", "relationships", "panel_cast", "reaction_segments", "presentation_plan"],
      "owner_agent": "script_writer",
      "required_when": {"any": [{"artifact_field_equals": ["broadcast_readable_config", "enabled", true]}, {"all": [{"not": {"artifact_exists": "broadcast_readable_config"}}, {"config_equals": ["script_source_mode", "SCREENPLAY_UNITS"]}, {"config_fields_present": ["broadcast_readable_output_profile_id", "broadcast_readable_output_profile_version"]}]}]}
    },
    "reenactment_character_script": {
      "path": "07_SCRIPT/reenactment_character_script.md",
      "depends_on": ["production_config", "screenplay_units", "characters", "relationships"],
      "owner_agent": "script_writer",
      "required_when": {"config_equals": ["script_source_mode", "SCREENPLAY_UNITS"]}
    },
    "reenactment_export_report": {
      "path": "08_QA/reenactment_export_report.json",
      "depends_on": ["production_config", "screenplay_units", "facts", "reenactment_character_script", "characters", "relationships", "crime_event_contract", "clue_matrix", "character_state_transitions", "presentation_plan", "reaction_segments", "drama_script", "narration_script", "panel_reaction_script", "expert_analysis_script", "draft_script", "final_script"],
      "owner_agent": "continuity_critic",
      "required_when": {"config_equals": ["script_source_mode", "SCREENPLAY_UNITS"]}
    },
    "broadcast_readable_report": {
      "path": "08_QA/broadcast_readable_report.json",
      "depends_on": ["production_config", "broadcast_readable_config", "screenplay_units", "characters", "relationships", "panel_cast", "reaction_segments", "presentation_plan", "final_script", "broadcast_readable_script"],
      "owner_agent": "continuity_critic",
      "required_when": {"any": [{"artifact_field_equals": ["broadcast_readable_config", "enabled", true]}, {"all": [{"not": {"artifact_exists": "broadcast_readable_config"}}, {"config_equals": ["script_source_mode", "SCREENPLAY_UNITS"]}, {"config_fields_present": ["broadcast_readable_output_profile_id", "broadcast_readable_output_profile_version"]}]}]}
    },
    "script_realization_report": {
      "path": "08_QA/script_realization_report.json",
      "depends_on": ["psychological_arc", "crime_event_contract", "scene_cards", "presentation_plan", "reaction_segments", "viewer_timeline", "final_script"],
      "owner_agent": "continuity_critic",
      "required_when": {"any": [{"capability_enabled": "SCENE_REALIZATION_POLICY"}, {"capability_enabled": "EXPLICIT_CRIME_EVENT_POLICY"}]}
    },
    "continuity_report": {
      "path": "08_QA/continuity_report.json",
      "depends_on": ["final_script", "actual_timeline", "viewer_timeline", "audience_belief", "knowledge_matrix", "clue_matrix", "panel_cast", "reaction_segments", "expert_segments", "drama_script", "narration_script", "panel_reaction_script", "expert_analysis_script", "presentation_plan", "script_realization_report"],
      "owner_agent": "continuity_critic"
    },
    "novelty_report": {
      "path": "08_QA/novelty_report.json",
      "depends_on": ["story_fingerprint"],
      "owner_agent": "novelty_auditor"
    },
    "reference_collision_report": {
      "path": "08_QA/reference_collision_report.json",
      "depends_on": ["final_script", "reference_profile"],
      "owner_agent": "reference_auditor"
    },
    "channel_consistency_report": {
      "path": "08_QA/channel_consistency_report.json",
      "depends_on": ["story_dna", "case_input", "crime_event_contract", "crime_psychology", "psychological_arc", "claim_evidence", "source_disclosure", "clinical_labels", "clue_matrix", "characters", "scene_cards", "expert_segments", "expert_analysis_script", "panel_reaction_script", "final_script", "presentation_plan", "script_realization_report", "production_config"],
      "owner_agent": "continuity_critic"
    },
    "validation_report": {
      "path": "08_QA/validation_report.json",
      "depends_on": ["continuity_report", "novelty_report", "reference_collision_report", "channel_consistency_report", "reenactment_export_report"],
      "owner_agent": "orchestrator"
    },
    "shooting_script": {
      "path": "09_PRODUCTION/shooting_script.md",
      "depends_on": ["validation_report", "final_script"],
      "owner_agent": "orchestrator"
    },
    "production_manifest": {
      "path": "09_PRODUCTION/production_manifest.json",
      "depends_on": ["production_footprint", "scene_cards", "shooting_script", "broadcast_readable_config", "broadcast_readable_script", "broadcast_readable_report", "production_broadcast_readable_script"],
      "owner_agent": "orchestrator",
      "required_when": {"production_manifest_required": true}
    },
    "narration": {
      "path": "09_PRODUCTION/narration.md",
      "depends_on": ["shooting_script", "presentation_plan"],
      "owner_agent": "orchestrator"
    },
    "production_panel_reaction_script": {
      "path": "09_PRODUCTION/panel_reaction_script.md",
      "depends_on": ["shooting_script", "panel_reaction_script", "reaction_segments"],
      "owner_agent": "orchestrator"
    },
    "production_expert_analysis_script": {
      "path": "09_PRODUCTION/expert_analysis_script.md",
      "depends_on": ["shooting_script", "expert_analysis_script", "expert_segments"],
      "owner_agent": "orchestrator",
      "required_when": {"all": [{"capability_enabled": "EXPERT_ANALYSIS_POLICY"}, {"source_truth_in": ["VERIFIED_TRUE_CASE", "INSPIRED_BY_TRUE_EVENTS"]}, {"artifact_status": ["expert_segments", "PLANNED"]}]}
    },
    "subtitle_script": {
      "path": "09_PRODUCTION/subtitle_script.md",
      "depends_on": ["shooting_script"],
      "owner_agent": "orchestrator"
    },
    "edit_script": {
      "path": "09_PRODUCTION/edit_script.md",
      "depends_on": ["shooting_script", "presentation_plan", "retention_plan", "production_panel_reaction_script", "production_expert_analysis_script"],
      "owner_agent": "orchestrator"
    },
    "production_reenactment_character_script": {
      "path": "09_PRODUCTION/reenactment_character_script.md",
      "depends_on": ["reenactment_character_script", "reenactment_export_report", "validation_report"],
      "owner_agent": "orchestrator",
      "required_when": {"config_equals": ["script_source_mode", "SCREENPLAY_UNITS"]}
    },
    "production_broadcast_readable_script": {
      "path": "09_PRODUCTION/broadcast_readable_script.md",
      "depends_on": ["production_config", "broadcast_readable_config", "broadcast_readable_script", "broadcast_readable_report", "validation_report"],
      "owner_agent": "orchestrator",
      "required_when": {"any": [{"artifact_field_equals": ["broadcast_readable_config", "enabled", true]}, {"all": [{"not": {"artifact_exists": "broadcast_readable_config"}}, {"config_equals": ["script_source_mode", "SCREENPLAY_UNITS"]}, {"config_fields_present": ["broadcast_readable_output_profile_id", "broadcast_readable_output_profile_version"]}]}]}
    },
    "editorial_review": {
      "path": "08_QA/editorial_review.json",
      "depends_on": ["crime_event_contract", "scene_cards", "final_script", "screenplay_units", "broadcast_readable_script", "broadcast_readable_report", "reenactment_character_script", "reenactment_export_report", "viewer_timeline", "audience_belief", "reaction_segments", "expert_segments", "presentation_plan", "panel_reaction_script", "expert_analysis_script", "script_realization_report", "shooting_script", "production_manifest", "narration", "production_panel_reaction_script", "production_expert_analysis_script", "subtitle_script", "edit_script", "production_reenactment_character_script", "production_broadcast_readable_script"],
      "owner_agent": "continuity_critic"
    }
  }
}
