{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/broadcast-readable-report-1.0.0.json",
  "title": "Broadcast Readable Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_family",
    "schema_version",
    "project_id",
    "result",
    "output_profile",
    "input_artifact_hashes",
    "output_markdown_sha256",
    "coverage",
    "source_style_evidence",
    "issues"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_family": {"const": "broadcast-readable-report"},
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "pattern": "^PRJ-[0-9]{3,}$"},
    "result": {"enum": ["PASS", "FAIL", "MISSING"]},
    "output_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "sha256"],
      "properties": {
        "profile_id": {"const": "BROADCAST_READABLE_SCRIPT"},
        "profile_version": {"$ref": "#/$defs/semanticVersion"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "input_artifact_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_config",
        "screenplay_units",
        "characters",
        "panel_cast",
        "reaction_segments",
        "presentation_plan",
        "broadcast_readable_output_profile"
      ],
      "properties": {
        "production_config": {"$ref": "#/$defs/sha256"},
        "screenplay_units": {"$ref": "#/$defs/sha256"},
        "characters": {"$ref": "#/$defs/sha256"},
        "panel_cast": {"$ref": "#/$defs/sha256"},
        "reaction_segments": {"$ref": "#/$defs/sha256"},
        "presentation_plan": {"$ref": "#/$defs/sha256"},
        "broadcast_readable_output_profile": {"$ref": "#/$defs/sha256"}
      }
    },
    "output_markdown_sha256": {"$ref": "#/$defs/sha256"},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_count",
        "unit_count",
        "character_count",
        "panelist_count",
        "panel_reaction_segment_count",
        "panel_turn_count",
        "presentation_segment_count"
      ],
      "properties": {
        "scene_count": {"type": "integer", "minimum": 0},
        "unit_count": {"type": "integer", "minimum": 0},
        "character_count": {"type": "integer", "minimum": 0},
        "panelist_count": {"type": "integer", "minimum": 0},
        "panel_reaction_segment_count": {"type": "integer", "minimum": 0},
        "panel_turn_count": {"type": "integer", "minimum": 0},
        "presentation_segment_count": {"type": "integer", "minimum": 0}
      }
    },
    "source_style_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordering_source",
        "unit_text_policy",
        "character_name_source",
        "panel_name_source",
        "scene_context_position",
        "internal_identifier_visibility",
        "scene_context_count",
        "canonical_unit_count",
        "character_row_count",
        "panelist_row_count",
        "panel_turn_count",
        "forbidden_marker_matches"
      ],
      "properties": {
        "ordering_source": {"const": "PRESENTATION_PLAN"},
        "unit_text_policy": {"const": "CANONICAL_EXACT"},
        "character_name_source": {"const": "CHARACTERS_NAME"},
        "panel_name_source": {"const": "PANEL_CAST_DISPLAY_NAME"},
        "scene_context_position": {"const": "BEFORE_SCENE_CONTENT"},
        "internal_identifier_visibility": {"const": "HIDDEN"},
        "scene_context_count": {"type": "integer", "minimum": 0},
        "canonical_unit_count": {"type": "integer", "minimum": 0},
        "character_row_count": {"type": "integer", "minimum": 0},
        "panelist_row_count": {"type": "integer", "minimum": 0},
        "panel_turn_count": {"type": "integer", "minimum": 0},
        "forbidden_marker_matches": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message", "artifact", "context"],
      "properties": {
        "severity": {"enum": ["ERROR", "WARN", "INFO"]},
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "message": {"type": "string", "minLength": 1},
        "artifact": {"type": "string", "minLength": 1},
        "context": {"type": "object"}
      }
    }
  }
}
