{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/broadcast-readable-output-profile-1.0.0.json",
  "title": "Broadcast Readable Output Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_family",
    "schema_version",
    "profile_id",
    "profile_version",
    "locale",
    "source_style_contract",
    "document_contract",
    "render_contract",
    "filter_contract"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_family": {"const": "broadcast-readable-output-profile"},
    "schema_version": {"const": "1.0.0"},
    "profile_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "profile_version": {"$ref": "#/$defs/semanticVersion"},
    "locale": {"type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$"},
    "source_style_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordering_source",
        "unit_text_policy",
        "character_name_source",
        "panel_name_source",
        "scene_context_position",
        "internal_identifier_visibility",
        "unknown_identity_policy"
      ],
      "properties": {
        "ordering_source": {"const": "PRESENTATION_PLAN"},
        "unit_text_policy": {"const": "CANONICAL_EXACT"},
        "character_name_source": {"const": "CHARACTERS_NAME"},
        "panel_name_source": {"const": "PANEL_CAST_DISPLAY_NAME"},
        "scene_context_position": {"const": "BEFORE_SCENE_CONTENT"},
        "internal_identifier_visibility": {"const": "HIDDEN"},
        "unknown_identity_policy": {"const": "FAIL"}
      }
    },
    "document_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title_template",
        "metadata_templates",
        "character_heading",
        "character_table_columns",
        "character_table_row_template",
        "panel_heading",
        "panel_table_columns",
        "panel_table_row_template",
        "table_divider",
        "scene_label_template",
        "scene_heading_template",
        "scene_context_template",
        "scene_context_entry_template",
        "scene_context_separator",
        "scene_context_fields",
        "scene_context_labels",
        "no_previous_scene_label",
        "panel_section_heading_template"
      ],
      "properties": {
        "title_template": {"type": "string", "pattern": "\\{title\\}"},
        "metadata_templates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project", "source_truth", "generation_basis"],
          "properties": {
            "project": {"type": "string", "pattern": "\\{project_id\\}"},
            "source_truth": {
              "type": "string",
              "pattern": "\\{source_truth_classification\\}"
            },
            "generation_basis": {"type": "string", "minLength": 1}
          }
        },
        "character_heading": {"type": "string", "minLength": 1},
        "character_table_columns": {"$ref": "#/$defs/twoColumns"},
        "character_table_row_template": {
          "type": "string",
          "allOf": [
            {"pattern": "\\{name\\}"},
            {"pattern": "\\{role\\}"}
          ]
        },
        "panel_heading": {"type": "string", "minLength": 1},
        "panel_table_columns": {"$ref": "#/$defs/twoColumns"},
        "panel_table_row_template": {
          "type": "string",
          "allOf": [
            {"pattern": "\\{display_name\\}"},
            {"pattern": "\\{voice_style\\}"}
          ]
        },
        "table_divider": {"type": "string", "minLength": 1},
        "scene_label_template": {
          "type": "string",
          "allOf": [
            {"pattern": "\\{order\\}"},
            {"pattern": "\\{title\\}"}
          ]
        },
        "scene_heading_template": {
          "type": "string",
          "pattern": "\\{scene_label\\}"
        },
        "scene_context_template": {"type": "string", "pattern": "\\{context\\}"},
        "scene_context_entry_template": {
          "type": "string",
          "allOf": [
            {"pattern": "\\{label\\}"},
            {"pattern": "\\{value\\}"}
          ]
        },
        "scene_context_separator": {"type": "string", "minLength": 1},
        "scene_context_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "location_description",
              "time_description",
              "previous_scene_id",
              "background_music_description",
              "sound_cues",
              "opening_character_state",
              "opening_emotional_state",
              "action_summary",
              "audience_information_gain",
              "retrospective_meaning"
            ]
          }
        },
        "scene_context_labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "location_description",
            "time_description",
            "previous_scene_id",
            "background_music_description",
            "sound_cues",
            "opening_character_state",
            "opening_emotional_state",
            "action_summary",
            "audience_information_gain",
            "retrospective_meaning"
          ],
          "properties": {
            "location_description": {"type": "string", "minLength": 1},
            "time_description": {"type": "string", "minLength": 1},
            "previous_scene_id": {"type": "string", "minLength": 1},
            "background_music_description": {"type": "string", "minLength": 1},
            "sound_cues": {"type": "string", "minLength": 1},
            "opening_character_state": {"type": "string", "minLength": 1},
            "opening_emotional_state": {"type": "string", "minLength": 1},
            "action_summary": {"type": "string", "minLength": 1},
            "audience_information_gain": {"type": "string", "minLength": 1},
            "retrospective_meaning": {"type": "string", "minLength": 1}
          }
        },
        "no_previous_scene_label": {"type": "string", "minLength": 1},
        "panel_section_heading_template": {"type": "string", "pattern": "\\{index\\}"}
      }
    },
    "render_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction_template",
        "sound_template",
        "screen_text_template",
        "dialogue_template",
        "character_authored_template",
        "delivery_template",
        "delivery_line_separator",
        "panel_turn_template",
        "special_unit_labels"
      ],
      "properties": {
        "direction_template": {"$ref": "#/$defs/textTemplate"},
        "sound_template": {"$ref": "#/$defs/textTemplate"},
        "screen_text_template": {"$ref": "#/$defs/textTemplate"},
        "dialogue_template": {
          "type": "string",
          "allOf": [
            {"pattern": "\\{speaker_name\\}"},
            {"pattern": "\\{delivery_block\\}"},
            {"pattern": "\\{text\\}"}
          ]
        },
        "character_authored_template": {
          "type": "string",
          "allOf": [
            {"pattern": "\\{speaker_name\\}"},
            {"pattern": "\\{label\\}"},
            {"pattern": "\\{delivery_block\\}"},
            {"pattern": "\\{text\\}"}
          ]
        },
        "delivery_template": {"type": "string", "pattern": "\\{instruction\\}"},
        "delivery_line_separator": {"type": "string", "minLength": 1},
        "panel_turn_template": {
          "type": "string",
          "allOf": [
            {"pattern": "\\{display_name\\}"},
            {"pattern": "\\{spoken_line\\}"}
          ]
        },
        "special_unit_labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "NARRATION",
            "INNER_MONOLOGUE",
            "HALLUCINATION",
            "MESSAGE",
            "CHAT",
            "NOTE",
            "RECORDING"
          ],
          "properties": {
            "NARRATION": {"type": "string", "minLength": 1},
            "INNER_MONOLOGUE": {"type": "string", "minLength": 1},
            "HALLUCINATION": {"type": "string", "minLength": 1},
            "MESSAGE": {"type": "string", "minLength": 1},
            "CHAT": {"type": "string", "minLength": 1},
            "NOTE": {"type": "string", "minLength": 1},
            "RECORDING": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "filter_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included_segment_types",
        "excluded_segment_types",
        "forbidden_internal_markers",
        "original_fiction_forbidden_uncertainty_markers"
      ],
      "properties": {
        "included_segment_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["DRAMA", "NARRATION", "PANEL_REACTION"]}
        },
        "excluded_segment_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["EXPERT_ANALYSIS", "AUDIENCE_PROMPT"]}
        },
        "forbidden_internal_markers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "original_fiction_forbidden_uncertainty_markers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "twoColumns": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "textTemplate": {"type": "string", "pattern": "\\{text\\}"}
  }
}
