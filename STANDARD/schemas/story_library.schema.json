{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/story-library-1.0.0.json",
  "title": "Production Ready Story Fingerprint Library",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_family", "schema_version", "fingerprints"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_family": {"const": "story-library"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "fingerprints": {
      "type": "array",
      "items": {"$ref": "#/$defs/fingerprint"}
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "object",
      "required": [
        "schema_family",
        "schema_version",
        "project_id",
        "story",
        "beat_signature",
        "causal"
      ],
      "properties": {
        "$schema": {"type": "string"},
        "schema_family": {"const": "story-fingerprint"},
        "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "project_id": {"type": "string", "pattern": "^PRJ-[0-9]{3,}$"},
        "story": {"type": "object", "minProperties": 1},
        "beat_signature": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "causal": {
          "type": "object",
          "required": ["root_cause", "mechanism", "concealment", "discovery_path", "resolution"],
          "properties": {
            "root_cause": {"type": "string", "minLength": 1},
            "mechanism": {"type": "string", "minLength": 1},
            "concealment": {"type": "string", "minLength": 1},
            "discovery_path": {"type": "string", "minLength": 1},
            "resolution": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
