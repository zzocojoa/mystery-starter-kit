{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/clue-matrix-legacy-1.1.json",
  "title": "Versioned Clue Matrix",
  "oneOf": [
    {"$ref": "#/$defs/legacyDocument"},
    {"$ref": "#/$defs/versionedDocument"}
  ],
  "$defs": {
    "projectId": {"type": "string", "pattern": "^PRJ-[0-9]{3,}$"},
    "canonicalId": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2,}$"},
    "nonBlankText": {"type": "string", "pattern": "\\S"},
    "baseClueProperties": {
      "type": "object",
      "properties": {
        "clue_id": {"$ref": "#/$defs/canonicalId"},
        "role": {"enum": ["CORE", "RED_HERRING", "SUPPORTING"]},
        "evidence_class": {
          "enum": [
            "RELATIONAL",
            "LINGUISTIC",
            "BEHAVIORAL",
            "TESTIMONIAL",
            "DOCUMENTARY",
            "PHYSICAL_OBJECT",
            "OWNERSHIP",
            "SOCIAL",
            "TECHNICAL"
          ]
        },
        "independent_ground_id": {
          "type": "string",
          "pattern": "^GROUND-[0-9]{2,}$"
        },
        "supports_final_reveal": {"type": "boolean"},
        "introduced_scene_order": {"type": "integer", "minimum": 1},
        "introduced_scene_id": {"$ref": "#/$defs/canonicalId"},
        "resolved_scene_order": {"type": ["integer", "null"], "minimum": 1},
        "resolved_scene_id": {"type": ["string", "null"]},
        "description": {"type": "string"},
        "content": {"type": "string"},
        "mechanism": {"type": "string"},
        "first_interpretation": {"type": "string"},
        "true_meaning": {"type": "string"},
        "object": {"type": "string"},
        "object_name": {"type": "string"},
        "evidence_object": {"type": "string"}
      }
    },
    "legacyClue": {
      "$ref": "#/$defs/baseClueProperties",
      "unevaluatedProperties": false,
      "required": ["clue_id", "role", "introduced_scene_order", "introduced_scene_id"]
    },
    "versionedClue": {
      "$ref": "#/$defs/baseClueProperties",
      "unevaluatedProperties": false,
      "required": ["clue_id", "role", "introduced_scene_order", "introduced_scene_id"],
      "properties": {
        "reveal_mode": {
          "enum": [
            "SEEDED_REINTERPRETATION",
            "INTENTIONAL_NON_MYSTERY_DISCLOSURE"
          ]
        },
        "surface_meaning": {"$ref": "#/$defs/nonBlankText"},
        "actual_meaning": {"$ref": "#/$defs/nonBlankText"},
        "first_seen_scene_id": {"$ref": "#/$defs/canonicalId"},
        "reveal_scene_id": {"$ref": "#/$defs/canonicalId"},
        "recontextualized_scene_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/canonicalId"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"supports_final_reveal": {"const": true}},
            "required": ["supports_final_reveal"]
          },
          "then": {"required": ["reveal_mode", "reveal_scene_id"]}
        },
        {
          "if": {
            "properties": {"reveal_mode": {"const": "SEEDED_REINTERPRETATION"}},
            "required": ["reveal_mode"]
          },
          "then": {
            "required": [
              "surface_meaning",
              "actual_meaning",
              "first_seen_scene_id",
              "reveal_scene_id",
              "recontextualized_scene_ids"
            ]
          }
        }
      ]
    },
    "legacyDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "clues"],
      "properties": {
        "$schema": {"type": "string"},
        "project_id": {"$ref": "#/$defs/projectId"},
        "final_proof_mechanism": {"type": "string"},
        "technical_dependency_level": {"type": "string"},
        "clues": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/legacyClue"}
        }
      },
      "not": {
        "anyOf": [
          {"required": ["schema_family"]},
          {"required": ["schema_version"]}
        ]
      }
    },
    "versionedDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_family", "schema_version", "project_id", "clues"],
      "properties": {
        "$schema": {"type": "string"},
        "schema_family": {"const": "clue-matrix"},
        "schema_version": {"const": "1.1.0"},
        "project_id": {"$ref": "#/$defs/projectId"},
        "final_proof_mechanism": {"type": "string"},
        "technical_dependency_level": {"type": "string"},
        "clues": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/versionedClue"}
        }
      }
    }
  }
}
