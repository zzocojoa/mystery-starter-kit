{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/variation-engine-registry-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_family", "schema_version", "engines"],
  "properties": {
    "schema_family": {"const": "variation-engine-registry"},
    "schema_version": {"const": "1.0.0"},
    "engines": {
      "type": "object",
      "minProperties": 2,
      "patternProperties": {
        "^[0-9]+\\.[0-9]+\\.[0-9]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm_id", "path", "algorithm_sha256", "implementation"],
          "properties": {
            "algorithm_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
            "path": {"type": "string", "pattern": "^STANDARD/variation_engines/[0-9]+\\.[0-9]+\\.[0-9]+\\.json$"},
            "algorithm_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "implementation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["entrypoint", "files", "implementation_sha256"],
              "properties": {
                "entrypoint": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"},
                "files": {
                  "type": "array",
                  "minItems": 2,
                  "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^VALIDATORS/variation_engines/(common|v[0-9]+_[0-9]+_[0-9]+)\\.py$"}
                },
                "implementation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
