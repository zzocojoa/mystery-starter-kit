{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/production-manifest-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_family",
    "schema_version",
    "project_id",
    "source_footprint_sha256",
    "scenes"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_family": {"const": "production-manifest"},
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "pattern": "^PRJ-[0-9]{3,}$"},
    "source_footprint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scene"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*-[0-9]{2,}$"},
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id",
        "location_id",
        "cast_ids",
        "child_actor_use",
        "vehicle_scene",
        "special_effect_level",
        "graphic_violence",
        "production_complexity"
      ],
      "properties": {
        "scene_id": {"type": "string", "pattern": "^SCN-[0-9]{2,}$"},
        "location_id": {"type": "string", "minLength": 1},
        "cast_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "child_actor_use": {"enum": ["NONE", "SUPPORTING", "PRIMARY"]},
        "vehicle_scene": {"enum": ["NONE", "STATIC", "MOVING"]},
        "special_effect_level": {"enum": ["NONE", "LOW", "MEDIUM", "HIGH"]},
        "graphic_violence": {"enum": ["NONE", "IMPLIED", "NON_GRAPHIC", "GRAPHIC"]},
        "production_complexity": {"enum": ["LOW", "MEDIUM", "HIGH", "EXTREME"]}
      }
    }
  }
}
