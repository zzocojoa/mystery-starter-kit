{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/clinical-labels-1.0.0.json",
  "title": "Clinical Label Classification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_family", "schema_version", "project_id", "labels"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_family": {"const": "clinical-labels"},
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "pattern": "^PRJ-[0-9]{3,}$"},
    "labels": {
      "type": "array",
      "items": {"$ref": "#/$defs/clinicalLabel"}
    }
  },
  "$defs": {
    "clinicalLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term",
        "classification",
        "source_claim_ids",
        "qualified_expert",
        "documented_assessment"
      ],
      "properties": {
        "term": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "pattern": "^CHAR-[0-9]{2,}$"},
        "source_subject_id": {"type": "string", "pattern": "^SUBJECT-[0-9]{2,}$"},
        "classification": {
          "enum": [
            "CONFIRMED_DIAGNOSIS",
            "EXPERT_ASSESSMENT",
            "MEDIA_DESCRIPTION",
            "NARRATOR_OPINION",
            "UNVERIFIED_LABEL"
          ]
        },
        "source_claim_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2,}$"}
        },
        "qualified_expert": {"type": "boolean"},
        "documented_assessment": {"type": "boolean"}
      },
      "anyOf": [
        {"required": ["subject_id"]},
        {"required": ["source_subject_id"]}
      ]
    }
  }
}
