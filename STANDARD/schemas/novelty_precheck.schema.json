{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/novelty-precheck-1.0.0.json",
  "title": "Variation Novelty Precheck Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "source_hash",
    "approved_candidate_id",
    "result",
    "candidate_results",
    "issues"
  ],
  "properties": {
    "project_id": {"type": "string", "pattern": "^PRJ-[0-9]{3,}$"},
    "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "approved_candidate_id": {"type": "string", "pattern": "^VAR-[0-9]{2,}$"},
    "result": {"enum": ["PASS", "FAIL"]},
    "candidate_results": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "result", "comparisons"],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^VAR-[0-9]{2,}$"},
          "result": {"enum": ["PASS", "FAIL"]},
          "comparisons": {"type": "array"}
        }
      }
    },
    "issues": {"type": "array"}
  }
}
