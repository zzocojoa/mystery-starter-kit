{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/candidate-projection-contract-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_family", "schema_version", "dimensions"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_family": {"const": "candidate-projection-contract"},
    "schema_version": {"const": "1.0.0"},
    "dimensions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/dimension"}
    }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification"],
      "properties": {
        "classification": {"enum": ["PROJECTED", "ADVISORY", "NON_PROJECTABLE"]},
        "reason": {"type": "string", "minLength": 1},
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/target"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"classification": {"const": "PROJECTED"}}},
          "then": {"required": ["targets"]},
          "else": {"required": ["reason"], "not": {"required": ["targets"]}}
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "json_path", "match"],
      "properties": {
        "artifact": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "json_path": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"},
        "match": {"enum": ["EQUALS", "CONTAINS"]}
      }
    }
  }
}
