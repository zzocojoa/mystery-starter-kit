{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/crime-event-contract-1.1.0.json",
  "title": "Bound Explicit Interpersonal Crime Event Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_family", "schema_version", "project_id", "approved_candidate_id",
    "candidate_selection_sha256", "candidate_event_brief_sha256", "event_id",
    "primary_crime", "related_crimes", "core_action_type", "responsible_agent_structure",
    "victim_structure", "offender_role_slots", "victim_role_slots", "protagonist_role_slot", "role_bindings", "actor_ids", "victim_ids", "protagonist_id",
    "relationship_context", "target_selection_reason", "initiating_context", "trigger_event",
    "motive_category", "motive_summary", "non_actionable_method_summary", "immediate_harm",
    "lasting_harm", "concealment_or_denial", "discovery_path", "responsibility_path",
    "central_pursuit_question", "harm_ids", "harm_classifications", "protagonist_goal",
    "protagonist_risk", "depiction_mode", "development_functions", "reveal_targets",
    "method_detail_level", "truth_basis"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_family": {"const": "crime-event-contract"},
    "schema_version": {"const": "1.1.0"},
    "project_id": {"type": "string", "pattern": "^PRJ-[0-9]{3,}$"},
    "approved_candidate_id": {"type": "string", "pattern": "^VAR-[0-9]{2,}$"},
    "candidate_selection_sha256": {"$ref": "#/$defs/hash"},
    "candidate_event_brief_sha256": {"$ref": "#/$defs/hash"},
    "event_id": {"type": "string", "pattern": "^EVENT-[0-9]{2,}$"},
    "primary_crime": {"$ref": "#/$defs/coreCrime"},
    "related_crimes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/coreCrime"}},
    "core_action_type": {"$ref": "#/$defs/crimeAction"},
    "responsible_agent_structure": {"enum": ["SINGLE_AGENT", "DUAL_AGENTS", "COMPLICIT_GROUP"]},
    "victim_structure": {"enum": ["SINGLE_VICTIM", "MULTIPLE_VICTIMS"]},
    "offender_role_slots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^OFFENDER-[0-9]{2,}$"}},
    "victim_role_slots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^VICTIM-[0-9]{2,}$"}},
    "protagonist_role_slot": {"type": "string", "pattern": "^PROTAGONIST-[0-9]{2,}$"},
    "role_bindings": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/roleBinding"}},
    "actor_ids": {"$ref": "#/$defs/characterIds"},
    "victim_ids": {"$ref": "#/$defs/characterIds"},
    "protagonist_id": {"type": "string", "pattern": "^CHAR-[0-9]{2,}$"},
    "relationship_context": {"$ref": "#/$defs/nonEmpty"},
    "target_selection_reason": {"$ref": "#/$defs/nonEmpty"},
    "initiating_context": {"$ref": "#/$defs/nonEmpty"},
    "trigger_event": {"$ref": "#/$defs/nonEmpty"},
    "motive_category": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "motive_summary": {"$ref": "#/$defs/nonEmpty"},
    "non_actionable_method_summary": {"$ref": "#/$defs/nonEmpty"},
    "immediate_harm": {"$ref": "#/$defs/nonEmpty"},
    "lasting_harm": {"$ref": "#/$defs/nonEmpty"},
    "concealment_or_denial": {"$ref": "#/$defs/nonEmpty"},
    "discovery_path": {"$ref": "#/$defs/nonEmpty"},
    "responsibility_path": {"$ref": "#/$defs/nonEmpty"},
    "central_pursuit_question": {"$ref": "#/$defs/nonEmpty"},
    "harm_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^HARM-[0-9]{2,}$"}},
    "harm_classifications": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["FATALITY", "BODILY_INJURY", "LIBERTY_DEPRIVATION", "SAFETY_COLLAPSE", "THREAT_OR_TRAUMA", "COMPOUND_HARM"]}},
    "protagonist_goal": {"$ref": "#/$defs/nonEmpty"},
    "protagonist_risk": {"$ref": "#/$defs/nonEmpty"},
    "depiction_mode": {"enum": ["DIRECT_NON_GRAPHIC", "IMPLIED", "AFTERMATH_CAUSAL"]},
    "development_functions": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/developmentFunction"}},
    "reveal_targets": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/revealTarget"}},
    "method_detail_level": {"const": "NON_ACTIONABLE_SUMMARY_ONLY"},
    "truth_basis": {"$ref": "#/$defs/truthBasis"}
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "coreCrime": {"enum": ["MURDER", "KIDNAPPING", "CONFINEMENT", "ASSAULT", "STALKING", "HOME_INVASION", "DATING_VIOLENCE", "DOMESTIC_VIOLENCE"]},
    "crimeAction": {"enum": ["MURDER", "KIDNAPPING", "CONFINEMENT", "ASSAULT", "STALKING", "HOME_INVASION"]},
    "characterIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^CHAR-[0-9]{2,}$"}},
    "roleBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_slot", "character_id", "role_type"],
      "properties": {
        "role_slot": {"type": "string", "pattern": "^(OFFENDER|VICTIM|PROTAGONIST|WITNESS|INVESTIGATOR|FAMILY)-[0-9]{2,}$"},
        "character_id": {"type": "string", "pattern": "^CHAR-[0-9]{2,}$"},
        "role_type": {"enum": ["OFFENDER", "VICTIM", "PROTAGONIST", "WITNESS", "INVESTIGATOR", "FAMILY"]}
      }
    },
    "developmentFunction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development_function_id", "function_type", "summary", "required"],
      "properties": {
        "development_function_id": {"type": "string", "pattern": "^CDEV-[0-9]{3,}$"},
        "function_type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "summary": {"$ref": "#/$defs/nonEmpty"},
        "required": {"type": "boolean"}
      }
    },
    "revealTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reveal_target_id", "target_type", "summary", "planned_phase", "planned_segment_id"],
      "properties": {
        "reveal_target_id": {"type": "string", "pattern": "^REVEAL-TARGET-[0-9]{2,}$"},
        "target_type": {"enum": ["CULPRIT", "MOTIVE", "METHOD", "HARM_RESULT"]},
        "summary": {"$ref": "#/$defs/nonEmpty"},
        "planned_phase": {"enum": ["EARLY", "MIDDLE", "LATE"]},
        "planned_segment_id": {"type": ["string", "null"], "pattern": "^SEG-[0-9]{3,}$"}
      }
    },
    "fieldEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "claim_ids"],
      "properties": {
        "classification": {"enum": ["FACT", "INFERENCE", "DRAMATIZATION", "UNKNOWN", "ORIGINAL_FICTION"]},
        "claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^FACT-[0-9]{2,}$"}}
      }
    },
    "truthBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_truth_classification", "field_evidence"],
      "properties": {
        "source_truth_classification": {"enum": ["ORIGINAL_FICTION", "VERIFIED_TRUE_CASE", "INSPIRED_BY_TRUE_EVENTS"]},
        "field_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["PRIMARY_CRIME", "CULPRIT", "MOTIVE", "METHOD", "HARM_RESULT", "LEGAL_OUTCOME"],
          "properties": {
            "PRIMARY_CRIME": {"$ref": "#/$defs/fieldEvidence"},
            "CULPRIT": {"$ref": "#/$defs/fieldEvidence"},
            "MOTIVE": {"$ref": "#/$defs/fieldEvidence"},
            "METHOD": {"$ref": "#/$defs/fieldEvidence"},
            "HARM_RESULT": {"$ref": "#/$defs/fieldEvidence"},
            "LEGAL_OUTCOME": {"$ref": "#/$defs/fieldEvidence"}
          }
        }
      }
    }
  }
}
