{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/broadcast-readable-report-2.0.0.json",
  "title": "Broadcast Readable Report 2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_family",
    "schema_version",
    "project_id",
    "result",
    "config_binding",
    "output_profile_binding",
    "input_artifact_hashes",
    "output_artifact_hashes",
    "scene_mappings",
    "segment_mappings",
    "unit_mappings",
    "relationship_mappings",
    "panel_turn_mappings",
    "special_unit_type_coverage",
    "reconstruction_coverage",
    "retrospective_meaning_coverage",
    "visibility_scan",
    "unsupported_segment_types",
    "issues"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_family": {"const": "broadcast-readable-report"},
    "schema_version": {"const": "2.0.0"},
    "project_id": {"type": "string", "pattern": "^PRJ-[0-9]{3,}$"},
    "result": {"enum": ["NEEDS_REVIEW", "MISSING", "FAIL"]},
    "config_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "enabled", "profile_id", "profile_version", "sha256"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "enabled": {"const": true},
        "profile_id": {"const": "BROADCAST_READABLE_SCRIPT"},
        "profile_version": {"const": "2.0.0"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "output_profile_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version",
        "profile_path",
        "schema_path",
        "document_sha256",
        "file_sha256"
      ],
      "properties": {
        "profile_id": {"const": "BROADCAST_READABLE_SCRIPT"},
        "profile_version": {"const": "2.0.0"},
        "profile_path": {
          "const": "CHANNELS/mystery_main/output_profiles/broadcast-readable-script/2.0.0.json"
        },
        "schema_path": {
          "const": "STANDARD/schemas/broadcast_readable_output_profile_2_0.schema.json"
        },
        "document_sha256": {"$ref": "#/$defs/sha256"},
        "file_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "input_artifact_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "broadcast_readable_config",
        "screenplay_units",
        "characters",
        "relationships",
        "panel_cast",
        "reaction_segments",
        "presentation_plan",
        "final_script"
      ],
      "properties": {
        "broadcast_readable_config": {"$ref": "#/$defs/sha256"},
        "screenplay_units": {"$ref": "#/$defs/sha256"},
        "characters": {"$ref": "#/$defs/sha256"},
        "relationships": {"$ref": "#/$defs/sha256"},
        "panel_cast": {"$ref": "#/$defs/sha256"},
        "reaction_segments": {"$ref": "#/$defs/sha256"},
        "presentation_plan": {"$ref": "#/$defs/sha256"},
        "final_script": {"$ref": "#/$defs/sha256"}
      }
    },
    "output_artifact_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_readable_script", "expected_production_copy"],
      "properties": {
        "canonical_readable_script": {"$ref": "#/$defs/sha256"},
        "expected_production_copy": {"$ref": "#/$defs/sha256"}
      }
    },
    "scene_mappings": {
      "type": "array",
      "items": {"$ref": "#/$defs/sceneMapping"}
    },
    "segment_mappings": {
      "type": "array",
      "items": {"$ref": "#/$defs/segmentMapping"}
    },
    "unit_mappings": {
      "type": "array",
      "items": {"$ref": "#/$defs/unitMapping"}
    },
    "relationship_mappings": {
      "type": "array",
      "items": {"$ref": "#/$defs/relationshipMapping"}
    },
    "panel_turn_mappings": {
      "type": "array",
      "items": {"$ref": "#/$defs/panelTurnMapping"}
    },
    "special_unit_type_coverage": {
      "type": "array",
      "items": {"$ref": "#/$defs/unitTypeCoverage"}
    },
    "reconstruction_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_sha256", "actual_sha256", "byte_identical"],
      "properties": {
        "expected_sha256": {"$ref": "#/$defs/sha256"},
        "actual_sha256": {"$ref": "#/$defs/sha256"},
        "byte_identical": {"type": "boolean"}
      }
    },
    "retrospective_meaning_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_count", "actual_count", "mappings_complete"],
      "properties": {
        "expected_count": {"type": "integer", "minimum": 0},
        "actual_count": {"type": "integer", "minimum": 0},
        "mappings_complete": {"type": "boolean"}
      }
    },
    "visibility_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forbidden_prefix_matches", "html_comment_matches", "uncertainty_marker_matches"],
      "properties": {
        "forbidden_prefix_matches": {
          "type": "array",
          "items": {"$ref": "#/$defs/visibleMatch"}
        },
        "html_comment_matches": {
          "type": "array",
          "items": {"$ref": "#/$defs/visibleMatch"}
        },
        "uncertainty_marker_matches": {
          "type": "array",
          "items": {"$ref": "#/$defs/visibleMatch"}
        }
      }
    },
    "unsupported_segment_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "issues": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "NEEDS_REVIEW"}}, "required": ["result"]},
      "then": {
        "properties": {
          "issues": {"maxItems": 0},
          "unsupported_segment_types": {"maxItems": 0},
          "reconstruction_coverage": {
            "properties": {"byte_identical": {"const": true}}
          }
        }
      },
      "else": {"properties": {"issues": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "byteRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byte_start", "byte_end"],
      "properties": {
        "byte_start": {"type": "integer", "minimum": 0},
        "byte_end": {"type": "integer", "minimum": 0}
      }
    },
    "sceneMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id",
        "first_global_segment_index",
        "last_global_segment_index",
        "heading_sha256",
        "situation_context_sha256",
        "sound_action_context_sha256",
        "retrospective_sha256",
        "actual_byte_range"
      ],
      "properties": {
        "scene_id": {"type": "string", "pattern": "^SCN-[0-9]{2,}$"},
        "first_global_segment_index": {"type": "integer", "minimum": 0},
        "last_global_segment_index": {"type": "integer", "minimum": 0},
        "heading_sha256": {"$ref": "#/$defs/sha256"},
        "situation_context_sha256": {"$ref": "#/$defs/sha256"},
        "sound_action_context_sha256": {"$ref": "#/$defs/sha256"},
        "retrospective_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "actual_byte_range": {"$ref": "#/$defs/byteRange"}
      }
    },
    "segmentMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "type", "global_presentation_index", "scene_id", "actual_byte_range"],
      "properties": {
        "segment_id": {"type": "string", "pattern": "^SEG-[0-9]{2,}$"},
        "type": {"enum": ["DRAMA", "NARRATION", "PANEL_REACTION"]},
        "global_presentation_index": {"type": "integer", "minimum": 0},
        "scene_id": {"type": "string", "pattern": "^SCN-[0-9]{2,}$"},
        "actual_byte_range": {"$ref": "#/$defs/byteRange"}
      }
    },
    "unitMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "segment_id", "canonical_order", "text_sha256", "exact_occurrence_index", "actual_byte_range"],
      "properties": {
        "unit_id": {"type": "string", "pattern": "^UNIT-[0-9]{2,}$"},
        "segment_id": {"type": "string", "pattern": "^SEG-[0-9]{2,}$"},
        "canonical_order": {"type": "integer", "minimum": 0},
        "text_sha256": {"$ref": "#/$defs/sha256"},
        "exact_occurrence_index": {"type": "integer", "minimum": 1},
        "actual_byte_range": {"$ref": "#/$defs/byteRange"}
      }
    },
    "relationshipMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship_id", "affected_character_rows", "display_summary_sha256"],
      "properties": {
        "relationship_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*-[0-9]{2,}$"},
        "affected_character_rows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^CHAR-[0-9]{2,}$"}
        },
        "display_summary_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "panelTurnMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reaction_segment_id", "turn_id", "global_order", "spoken_line_sha256", "actual_byte_range"],
      "properties": {
        "reaction_segment_id": {"type": "string", "pattern": "^RSEG-[0-9]{2,}$"},
        "turn_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*-[0-9]{2,}$"},
        "global_order": {"type": "integer", "minimum": 0},
        "spoken_line_sha256": {"$ref": "#/$defs/sha256"},
        "actual_byte_range": {"$ref": "#/$defs/byteRange"}
      }
    },
    "unitTypeCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_type", "canonical_count", "actual_count"],
      "properties": {
        "unit_type": {"type": "string", "minLength": 1},
        "canonical_count": {"type": "integer", "minimum": 0},
        "actual_count": {"type": "integer", "minimum": 0}
      }
    },
    "visibleMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "byte_start", "byte_end"],
      "properties": {
        "token": {"type": "string", "minLength": 1},
        "byte_start": {"type": "integer", "minimum": 0},
        "byte_end": {"type": "integer", "minimum": 0}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message", "artifact", "context"],
      "properties": {
        "severity": {"enum": ["ERROR", "WARN", "INFO"]},
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "message": {"type": "string", "minLength": 1},
        "artifact": {"type": "string", "minLength": 1},
        "context": {"type": "object"}
      }
    }
  }
}
