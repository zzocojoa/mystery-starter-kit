{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/reenactment-output-profile-1.0.0.json",
  "title": "Reenactment Output Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_family",
    "schema_version",
    "profile_id",
    "profile_version",
    "locale",
    "document_contract",
    "render_contract",
    "filter_contract"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_family": {"const": "reenactment-output-profile"},
    "schema_version": {"const": "1.0.0"},
    "profile_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "profile_version": {"$ref": "#/$defs/semanticVersion"},
    "locale": {"type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$"},
    "document_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_headings",
        "cast_table",
        "scene_heading_template",
        "scene_context_fields"
      ],
      "properties": {
        "required_headings": {
          "type": "array",
          "prefixItems": [
            {"const": "작품 정보"},
            {"const": "등장인물"},
            {"const": "장면별 인물 대사"}
          ],
          "items": false
        },
        "cast_table": {
          "type": "object",
          "additionalProperties": false,
          "required": ["columns", "sort_by", "unknown_character_policy"],
          "properties": {
            "columns": {
              "type": "array",
              "prefixItems": [
                {"const": "인물"},
                {"const": "역할"},
                {"const": "관계"}
              ],
              "items": false
            },
            "sort_by": {"const": "FIRST_APPEARANCE_THEN_CHARACTER_ID"},
            "unknown_character_policy": {"const": "FAIL"}
          }
        },
        "scene_heading_template": {"const": "## 장면 {order}. {title}"},
        "scene_context_fields": {
          "type": "array",
          "prefixItems": [
            {"const": "location_description"},
            {"const": "time_description"},
            {"const": "previous_scene_id"},
            {"const": "background_music_description"},
            {"const": "sound_cues"},
            {"const": "opening_character_state"},
            {"const": "opening_emotional_state"},
            {"const": "action_summary"},
            {"const": "audience_information_gain"},
            {"const": "retrospective_meaning"}
          ],
          "items": false
        }
      }
    },
    "render_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction_template",
        "sound_template",
        "speaker_template",
        "character_authored_template",
        "special_unit_labels"
      ],
      "properties": {
        "direction_template": {"const": "[지문] {text}"},
        "sound_template": {"const": "[음향] {text}"},
        "speaker_template": {"const": "{speaker_name}: {text}"},
        "character_authored_template": {"const": "[{label}] {speaker_name}: {text}"},
        "special_unit_labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "NARRATION",
            "INNER_MONOLOGUE",
            "HALLUCINATION",
            "MESSAGE",
            "CHAT",
            "NOTE",
            "RECORDING",
            "SCREEN_TEXT"
          ],
          "properties": {
            "NARRATION": {"const": "내레이션"},
            "INNER_MONOLOGUE": {"const": "속마음"},
            "HALLUCINATION": {"const": "환청·환각"},
            "MESSAGE": {"const": "메시지"},
            "CHAT": {"const": "채팅"},
            "NOTE": {"const": "메모"},
            "RECORDING": {"const": "녹음"},
            "SCREEN_TEXT": {"const": "화면 문구"}
          }
        }
      }
    },
    "filter_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included_layers",
        "excluded_layers",
        "included_unit_types",
        "excluded_unit_types",
        "strip_internal_markers",
        "forbidden_internal_markers",
        "original_fiction_forbidden_uncertainty_markers"
      ],
      "properties": {
        "included_layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["DRAMA", "NARRATION"]}
        },
        "excluded_layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["PANEL_REACTION", "EXPERT_ANALYSIS", "AUDIENCE_PROMPT"]}
        },
        "included_unit_types": {"$ref": "#/$defs/unitTypeList"},
        "excluded_unit_types": {"$ref": "#/$defs/unitTypeList"},
        "strip_internal_markers": {"const": true},
        "forbidden_internal_markers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "original_fiction_forbidden_uncertainty_markers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "unitTypeList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "ACTION",
          "SOUND",
          "DIALOGUE",
          "NARRATION",
          "INNER_MONOLOGUE",
          "HALLUCINATION",
          "MESSAGE",
          "CHAT",
          "NOTE",
          "RECORDING",
          "SCREEN_TEXT"
        ]
      }
    }
  }
}
