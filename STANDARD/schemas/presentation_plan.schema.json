{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/presentation-plan-2.0.0.json",
  "title": "Presentation Plan Contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_family",
    "schema_version",
    "project_id",
    "modes",
    "segments"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_family": {
      "const": "presentation-plan"
    },
    "schema_version": {
      "enum": ["2.0.0", "2.1.0"]
    },
    "project_id": {
      "type": "string",
      "pattern": "^PRJ-[0-9]{3,}$"
    },
    "modes": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "DRAMA",
          "NARRATION",
          "PANEL_REACTION",
          "AUDIENCE_PROMPT",
          "EXPERT_ANALYSIS"
        ]
      },
      "allOf": [
        {"contains": {"const": "DRAMA"}},
        {"contains": {"const": "NARRATION"}},
        {"contains": {"const": "PANEL_REACTION"}}
      ]
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/presentationSegment"
      }
    }
  },
  "$defs": {
    "identifierList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]+-[0-9]{2,}$"
      }
    },
    "revealTargetList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^REVEAL-TARGET-[0-9]{2,}$"
      }
    },
    "presentationSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "segment_type",
        "scene_id",
        "start_sec",
        "duration_sec",
        "source_artifact",
        "revealed_fact_ids",
        "revealed_clue_ids"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "pattern": "^SEG-[0-9]{3,}$"
        },
        "segment_type": {
          "enum": [
            "DRAMA",
            "NARRATION",
            "PANEL_REACTION",
            "AUDIENCE_PROMPT",
            "EXPERT_ANALYSIS"
          ]
        },
        "scene_id": {
          "type": "string",
          "pattern": "^SCN-[0-9]{2,}$"
        },
        "reaction_segment_id": {
          "type": "string",
          "pattern": "^RSEG-[0-9]{3,}$"
        },
        "start_sec": {
          "type": "number",
          "minimum": 0
        },
        "duration_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "source_artifact": {
          "enum": [
            "drama_script",
            "narration_script",
            "panel_reaction_script",
            "expert_analysis_script"
          ]
        },
        "revealed_fact_ids": {
          "$ref": "#/$defs/identifierList"
        },
        "revealed_clue_ids": {
          "$ref": "#/$defs/identifierList"
        },
        "referenced_fact_ids": {
          "$ref": "#/$defs/identifierList"
        },
        "referenced_clue_ids": {
          "$ref": "#/$defs/identifierList"
        },
        "referenced_reveal_target_ids": {
          "$ref": "#/$defs/revealTargetList"
        },
        "revealed_reveal_target_ids": {
          "$ref": "#/$defs/revealTargetList"
        },
        "intentional_prereveal_ids": {
          "$ref": "#/$defs/revealTargetList"
        },
        "psychological_stage_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^PSTAGE-[0-9]{3,}$"}
        },
        "psychological_stage_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
        },
        "narration_function": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "narrator_character_id": {
          "type": "string",
          "pattern": "^[A-Z]+-[0-9]{2,}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"segment_type": {"const": "DRAMA"}}
          },
          "then": {
            "properties": {"source_artifact": {"const": "drama_script"}}
          }
        },
        {
          "if": {
            "properties": {"segment_type": {"const": "NARRATION"}}
          },
          "then": {
            "properties": {"source_artifact": {"const": "narration_script"}}
          }
        },
        {
          "if": {
            "properties": {"segment_type": {"const": "PANEL_REACTION"}}
          },
          "then": {
            "required": ["reaction_segment_id"],
            "properties": {"source_artifact": {"const": "panel_reaction_script"}}
          }
        },
        {
          "if": {
            "properties": {"segment_type": {"const": "EXPERT_ANALYSIS"}}
          },
          "then": {
            "properties": {"source_artifact": {"const": "expert_analysis_script"}}
          }
        }
      ]
    }
  }
}
