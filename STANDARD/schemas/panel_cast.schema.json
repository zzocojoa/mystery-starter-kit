{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/panel-cast-2.0.0.json",
  "title": "Panel Cast Contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_family",
    "schema_version",
    "project_id",
    "panelists"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_family": {
      "const": "panel-cast"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^PRJ-[0-9]{3,}$"
    },
    "panelists": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "panelist_id",
          "display_name",
          "persona",
          "voice_style",
          "allowed_functions",
          "knowledge_scope"
        ],
        "properties": {
          "panelist_id": {
            "type": "string",
            "pattern": "^PANEL-[0-9]{2,}$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "persona": {
            "enum": [
              "LOGIC_ANALYST",
              "EMOTIONAL_PROXY",
              "SKEPTIC"
            ]
          },
          "voice_style": {
            "type": "string",
            "minLength": 1
          },
          "allowed_functions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/panelFunction"
            }
          },
          "knowledge_scope": {
            "const": "REVEALED_INFORMATION_ONLY"
          }
        }
      }
    }
  },
  "$defs": {
    "panelFunction": {
      "enum": [
        "EMOTIONAL_REACTION",
        "ANOMALY_DETECTION",
        "HYPOTHESIS_GENERATION",
        "SUSPECT_DISCUSSION",
        "HYPOTHESIS_REVISION",
        "CONTRADICTION_DETECTION",
        "MORAL_REACTION",
        "TENSION_RELEASE",
        "EXPECTATION_BUILDING",
        "RISK_SIGNAL_RECOGNITION",
        "VICTIM_CONTEXTUALIZATION",
        "BELIEF_CORRECTION"
      ]
    }
  }
}
