{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/candidate-evaluation-1.0.0.json",
  "title": "Variation Candidate Evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_family",
    "schema_version",
    "project_id",
    "selected_candidate_id",
    "evaluations"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_family": {"const": "candidate-evaluation"},
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "pattern": "^PRJ-[0-9]{3,}$"},
    "selected_candidate_id": {"type": "string", "pattern": "^VAR-[0-9]{2,}$"},
    "evaluations": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/evaluation"}
    }
  },
  "$defs": {
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "hard_filter_result",
        "crime_threat_score",
        "psychological_immersion_score",
        "trust_betrayal_score",
        "victim_integrity_score",
        "character_score",
        "twist_score",
        "novelty_score",
        "production_score",
        "total_score",
        "decision",
        "decision_reason"
      ],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^VAR-[0-9]{2,}$"},
        "hard_filter_result": {"enum": ["PASS", "FAIL"]},
        "crime_threat_score": {"$ref": "#/$defs/score"},
        "psychological_immersion_score": {"$ref": "#/$defs/score"},
        "trust_betrayal_score": {"$ref": "#/$defs/score"},
        "victim_integrity_score": {"$ref": "#/$defs/score"},
        "character_score": {"$ref": "#/$defs/score"},
        "twist_score": {"$ref": "#/$defs/score"},
        "novelty_score": {"$ref": "#/$defs/score"},
        "production_score": {"$ref": "#/$defs/score"},
        "total_score": {"$ref": "#/$defs/score"},
        "decision": {"enum": ["APPROVED", "REJECTED"]},
        "decision_reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
