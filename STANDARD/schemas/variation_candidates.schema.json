{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/variation-candidates-1.0.0.json",
  "title": "Generated Story Variation Candidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "story_seed_hash",
    "variation_engine_version",
    "variation_catalog_version",
    "catalog_sha256",
    "algorithm_sha256",
    "implementation_sha256",
    "candidate_count",
    "candidates",
    "batch_trace",
    "approved_candidate_id",
    "override"
  ],
  "properties": {
    "project_id": {"type": "string", "pattern": "^PRJ-[0-9]{3,}$"},
    "story_seed_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "variation_engine_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "variation_catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "catalog_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "algorithm_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "implementation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_count": {"type": "integer", "minimum": 3},
    "candidates": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "origin_batch_id",
          "batch_candidate_id",
          "variation_engine_version",
          "variation_catalog_version",
          "catalog_sha256",
          "algorithm_sha256",
          "implementation_sha256",
          "selection",
          "signature",
          "selection_status"
        ],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^VAR-[0-9]{2,}$"},
          "origin_batch_id": {"type": "string", "pattern": "^BATCH-[0-9]{2,}$"},
          "batch_candidate_id": {"type": "string", "pattern": "^BVAR-[0-9]{2,}$"},
          "variation_engine_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "variation_catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "catalog_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "algorithm_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "implementation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "selection": {
            "type": "object",
            "minProperties": 10,
            "additionalProperties": {"type": "string", "minLength": 1}
          },
          "policy_profile": {"$ref": "#/$defs/policyProfile"},
          "crime_event": {"$ref": "#/$defs/crimeEventOutline"},
          "signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "selection_status": {"enum": ["PENDING", "APPROVED", "REJECTED"]}
        }
      }
    },
    "batch_trace": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["batch_id", "batch_nonce", "generated_count", "novelty_pass_count", "eligible_count", "accepted_count", "rejections"],
        "properties": {
          "batch_id": {"type": "string", "pattern": "^BATCH-[0-9]{2,}$"},
          "batch_nonce": {"type": "integer", "minimum": 0},
          "generated_count": {"type": "integer", "minimum": 0},
          "novelty_pass_count": {"type": "integer", "minimum": 0},
          "eligible_count": {"type": "integer", "minimum": 0},
          "accepted_count": {"type": "integer", "minimum": 0},
          "rejections": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "approved_candidate_id": {
      "type": ["string", "null"],
      "pattern": "^VAR-[0-9]{2,}$"
    },
    "override": {"type": ["object", "null"]}
  },
  "$defs": {
    "enumName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "enumId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]*$"
    },
    "policyProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "genre",
        "threat_type",
        "trusted_domain",
        "safe_domain_betrayal",
        "responsible_agent_structure",
        "information_mechanism",
        "clue_mechanism",
        "reveal_mode",
        "final_proof_mechanism",
        "victim_agency_mode",
        "incident_type",
        "culprit_structure",
        "primary_twist",
        "pressure_engine",
        "technical_dependency_level",
        "production_complexity",
        "location_count",
        "major_character_count",
        "special_effect_level",
        "child_actor_use",
        "vehicle_scene",
        "graphic_violence",
        "source_truth_classification",
        "episode_theme"
      ],
      "properties": {
        "genre": {"$ref": "#/$defs/enumName"},
        "threat_type": {"$ref": "#/$defs/enumName"},
        "trusted_domain": {"$ref": "#/$defs/enumName"},
        "safe_domain_betrayal": {"$ref": "#/$defs/enumName"},
        "responsible_agent_structure": {"$ref": "#/$defs/enumName"},
        "information_mechanism": {"$ref": "#/$defs/enumName"},
        "clue_mechanism": {"$ref": "#/$defs/enumName"},
        "reveal_mode": {"$ref": "#/$defs/enumName"},
        "final_proof_mechanism": {"$ref": "#/$defs/enumName"},
        "victim_agency_mode": {"$ref": "#/$defs/enumName"},
        "incident_type": {"$ref": "#/$defs/enumName"},
        "culprit_structure": {"$ref": "#/$defs/enumName"},
        "primary_twist": {"$ref": "#/$defs/enumId"},
        "pressure_engine": {"$ref": "#/$defs/enumName"},
        "technical_dependency_level": {
          "enum": ["LOW", "MEDIUM", "HIGH", "FINAL_PROOF"]
        },
        "production_complexity": {"enum": ["LOW", "MEDIUM", "HIGH", "EXTREME"]},
        "location_count": {"$ref": "#/$defs/enumName"},
        "major_character_count": {"$ref": "#/$defs/enumName"},
        "special_effect_level": {"$ref": "#/$defs/enumName"},
        "child_actor_use": {"$ref": "#/$defs/enumName"},
        "vehicle_scene": {"$ref": "#/$defs/enumName"},
        "graphic_violence": {"$ref": "#/$defs/enumName"},
        "source_truth_classification": {
          "enum": [
            "ORIGINAL_FICTION",
            "VERIFIED_TRUE_CASE",
            "INSPIRED_BY_TRUE_EVENTS"
          ]
        },
        "episode_theme": {"$ref": "#/$defs/enumName"}
      }
    },
    "crimeEventOutline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "primary_crime",
        "related_crimes",
        "core_action_type",
        "relationship_context",
        "actor_ids",
        "victim_ids",
        "motive",
        "act_summary",
        "harm_ids",
        "harm_result",
        "harm_classifications",
        "protagonist_goal",
        "protagonist_risk",
        "depiction_mode",
        "development_functions",
        "reveal_targets",
        "method_detail_level",
        "centrality",
        "truth_status"
      ],
      "properties": {
        "event_id": {"type": "string", "pattern": "^EVENT-[0-9]{2,}$"},
        "primary_crime": {"$ref": "#/$defs/coreCrime"},
        "related_crimes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/coreCrime"}
        },
        "core_action_type": {"$ref": "#/$defs/crimeAction"},
        "relationship_context": {"type": "string", "minLength": 1},
        "actor_ids": {"$ref": "#/$defs/characterIds"},
        "victim_ids": {"$ref": "#/$defs/characterIds"},
        "motive": {"type": "string", "minLength": 1},
        "act_summary": {"type": "string", "minLength": 1},
        "harm_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^HARM-[0-9]{2,}$"}
        },
        "harm_result": {"type": "string", "minLength": 1},
        "harm_classifications": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["FATALITY", "BODILY_INJURY", "LIBERTY_DEPRIVATION", "SAFETY_COLLAPSE", "THREAT_OR_TRAUMA", "COMPOUND_HARM"]
          }
        },
        "protagonist_goal": {"type": "string", "minLength": 1},
        "protagonist_risk": {"type": "string", "minLength": 1},
        "depiction_mode": {"enum": ["DIRECT_NON_GRAPHIC", "IMPLIED", "AFTERMATH_CAUSAL"]},
        "development_functions": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
        },
        "reveal_targets": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/candidateRevealTarget"}
        },
        "method_detail_level": {"const": "NON_ACTIONABLE_SUMMARY_ONLY"},
        "centrality": {"const": "CENTRAL"},
        "truth_status": {"enum": ["ORIGINAL_FICTION", "EVIDENCE_LOCK_REQUIRED"]}
      }
    },
    "coreCrime": {
      "enum": ["MURDER", "KIDNAPPING", "CONFINEMENT", "ASSAULT", "STALKING", "HOME_INVASION", "DATING_VIOLENCE", "DOMESTIC_VIOLENCE"]
    },
    "crimeAction": {
      "enum": ["MURDER", "KIDNAPPING", "CONFINEMENT", "ASSAULT", "STALKING", "HOME_INVASION"]
    },
    "characterIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^CHAR-[0-9]{2,}$"}
    },
    "candidateRevealTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reveal_target_id", "target_type", "summary", "planned_phase", "planned_segment_id"],
      "properties": {
        "reveal_target_id": {"type": "string", "pattern": "^REVEAL-TARGET-[0-9]{2,}$"},
        "target_type": {"enum": ["CULPRIT", "MOTIVE", "METHOD", "HARM_RESULT"]},
        "summary": {"type": "string", "minLength": 1},
        "planned_phase": {"enum": ["EARLY", "MIDDLE", "LATE"]},
        "planned_segment_id": {"type": ["string", "null"], "pattern": "^SEG-[0-9]{3,}$"}
      }
    }
  }
}
