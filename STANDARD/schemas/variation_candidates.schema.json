{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/variation-candidates-1.0.0.json",
  "title": "Generated Story Variation Candidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "story_seed_hash",
    "candidate_count",
    "candidates",
    "approved_candidate_id",
    "override"
  ],
  "properties": {
    "project_id": {"type": "string", "pattern": "^PRJ-[0-9]{3,}$"},
    "story_seed_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_count": {"type": "integer", "minimum": 3},
    "candidates": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "selection",
          "policy_profile",
          "signature",
          "selection_status"
        ],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^VAR-[0-9]{2,}$"},
          "selection": {
            "type": "object",
            "minProperties": 10,
            "additionalProperties": {"type": "string", "minLength": 1}
          },
          "policy_profile": {"$ref": "#/$defs/policyProfile"},
          "signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "selection_status": {"enum": ["PENDING", "APPROVED", "REJECTED"]}
        }
      }
    },
    "approved_candidate_id": {
      "type": ["string", "null"],
      "pattern": "^VAR-[0-9]{2,}$"
    },
    "override": {"type": ["object", "null"]}
  },
  "$defs": {
    "enumName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "policyProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threat_type",
        "trusted_domain",
        "incident_type",
        "culprit_structure",
        "psychological_engine",
        "technical_dependency_level",
        "source_truth_classification",
        "episode_theme"
      ],
      "properties": {
        "threat_type": {"$ref": "#/$defs/enumName"},
        "trusted_domain": {"$ref": "#/$defs/enumName"},
        "incident_type": {"$ref": "#/$defs/enumName"},
        "culprit_structure": {"$ref": "#/$defs/enumName"},
        "psychological_engine": {"$ref": "#/$defs/enumName"},
        "technical_dependency_level": {
          "enum": ["LOW", "MEDIUM", "HIGH", "FINAL_PROOF"]
        },
        "source_truth_classification": {
          "enum": [
            "ORIGINAL_FICTION",
            "VERIFIED_TRUE_CASE",
            "INSPIRED_BY_TRUE_EVENTS"
          ]
        },
        "episode_theme": {"$ref": "#/$defs/enumName"}
      }
    }
  }
}
