{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/causal-graph-1.0.0.json",
  "title": "Mystery Causal Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "nodes", "edges", "fingerprint"],
  "properties": {
    "project_id": {"type": "string", "pattern": "^PRJ-[0-9]{3,}$"},
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["node_id", "type"],
        "properties": {
          "node_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2,}$"},
          "type": {
            "enum": [
              "ROOT_CAUSE",
              "MECHANISM",
              "CONCEALMENT",
              "DISCOVERY",
              "CONSEQUENCE",
              "RESOLUTION"
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2,}$"},
          "to": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2,}$"}
        }
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_cause", "mechanism", "concealment", "discovery_path", "resolution"],
      "properties": {
        "root_cause": {"type": "string", "minLength": 1},
        "mechanism": {"type": "string", "minLength": 1},
        "concealment": {"type": "string", "minLength": 1},
        "discovery_path": {"type": "string", "minLength": 1},
        "resolution": {"type": "string", "minLength": 1}
      }
    }
  }
}
