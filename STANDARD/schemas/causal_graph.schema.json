{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/causal-graph-1.1.0.json",
  "title": "Mystery Causal Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "nodes", "edges", "fingerprint", "semantic_normalization"],
  "properties": {
    "project_id": {"type": "string", "pattern": "^PRJ-[0-9]{3,}$"},
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["node_id", "type"],
        "properties": {
          "node_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2,}$"},
          "source_event_id": {"type": "string", "pattern": "^VEVT-[0-9]{2,}$"},
          "crime_event_id": {"type": "string", "pattern": "^EVENT-[0-9]{2,}$"},
          "actor_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2,}$"}
          },
          "victim_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2,}$"}
          },
          "harm_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^HARM-[0-9]{2,}$"}
          },
          "type": {
            "enum": [
              "ROOT_CAUSE",
              "MECHANISM",
              "CONCEALMENT",
              "DISCOVERY",
              "CONSEQUENCE",
              "RESOLUTION",
              "MOTIVE_OR_TRIGGER",
              "CRIME_EVENT",
              "HARM_RESULT",
              "CONCEALMENT_OR_DENIAL",
              "DISCOVERY_PATH",
              "RESPONSIBILITY_CONFIRMATION"
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2,}$"},
          "to": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2,}$"}
        }
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_cause", "mechanism", "concealment", "discovery_path", "resolution"],
      "properties": {
        "root_cause": {"type": "string", "minLength": 1},
        "mechanism": {"type": "string", "minLength": 1},
        "concealment": {"type": "string", "minLength": 1},
        "discovery_path": {"type": "string", "minLength": 1},
        "resolution": {"type": "string", "minLength": 1}
      }
    },
    "semantic_normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalized_roles",
        "character_function_chain",
        "audience_hypothesis_transitions"
      ],
      "properties": {
        "normalized_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
        },
        "character_function_chain": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
        },
        "audience_hypothesis_transitions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
        }
      }
    }
  }
}
