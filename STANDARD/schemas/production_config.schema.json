{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/production-config-1.0.0.json",
  "title": "Mystery Production Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "standard_version",
    "channel_id",
    "channel_content_version",
    "variation_engine_version",
    "variation_catalog_version",
    "approval_policy",
    "story_source_mode",
    "source_truth_classification",
    "genre",
    "tones",
    "target_runtime_minutes",
    "runtime_tolerance_ratio"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "project_id": {"type": "string", "pattern": "^PRJ-[0-9]{3,}$"},
    "standard_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "channel_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "channel_content_version": {"$ref": "#/$defs/semanticVersion"},
    "variation_engine_version": {"$ref": "#/$defs/semanticVersion"},
    "variation_catalog_version": {"$ref": "#/$defs/semanticVersion"},
    "approval_policy": {"enum": ["AUTO_CONTINUE", "HUMAN_REVIEW"]},
    "script_source_mode": {
      "enum": ["LEGACY_MARKDOWN", "SCREENPLAY_UNITS"],
      "default": "LEGACY_MARKDOWN"
    },
    "reenactment_output_profile_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "reenactment_output_profile_version": {"$ref": "#/$defs/semanticVersion"},
    "story_source_mode": {
      "enum": ["ORIGINAL", "USER_CASE", "REFERENCE_INSPIRED", "TRUE_STORY", "INSPIRED_BY_TRUE_EVENTS"]
    },
    "source_truth_classification": {
      "enum": [
        "ORIGINAL_FICTION",
        "VERIFIED_TRUE_CASE",
        "INSPIRED_BY_TRUE_EVENTS"
      ]
    },
    "user_case_constraints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/userCaseConstraint"
      }
    },
    "genre": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "tones": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
    },
    "target_runtime_minutes": {"type": "number", "exclusiveMinimum": 0},
    "runtime_tolerance_ratio": {"type": "number", "minimum": 0, "exclusiveMaximum": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "story_source_mode": {"const": "USER_CASE"}
        }
      },
      "then": {
        "required": ["user_case_constraints"]
      },
      "else": {
        "not": {"required": ["user_case_constraints"]}
      }
    },
    {
      "if": {
        "properties": {"story_source_mode": {"const": "ORIGINAL"}}
      },
      "then": {
        "properties": {
          "source_truth_classification": {"const": "ORIGINAL_FICTION"}
        }
      }
    },
    {
      "if": {
        "properties": {"story_source_mode": {"const": "TRUE_STORY"}}
      },
      "then": {
        "properties": {
          "source_truth_classification": {"const": "VERIFIED_TRUE_CASE"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "story_source_mode": {"const": "INSPIRED_BY_TRUE_EVENTS"}
        }
      },
      "then": {
        "properties": {
          "source_truth_classification": {"const": "INSPIRED_BY_TRUE_EVENTS"}
        }
      }
    },
    {
      "if": {
        "required": ["script_source_mode"],
        "properties": {
          "script_source_mode": {"const": "SCREENPLAY_UNITS"}
        }
      },
      "then": {
        "required": [
          "reenactment_output_profile_id",
          "reenactment_output_profile_version"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["reenactment_output_profile_id"]},
            {"required": ["reenactment_output_profile_version"]}
          ]
        }
      }
    }
  ],
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "userCaseConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "value", "status"],
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "value": {
          "type": ["string", "null"]
        },
        "status": {
          "enum": ["LOCKED", "FLEXIBLE", "UNKNOWN"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "UNKNOWN"}}
          },
          "then": {
            "properties": {"value": {"const": null}}
          },
          "else": {
            "properties": {"value": {"type": "string", "minLength": 1}}
          }
        }
      ]
    }
  }
}
