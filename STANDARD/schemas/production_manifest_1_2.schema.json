{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/production-manifest-1.2.0.json",
  "title": "Production Manifest 1.2.0 Deliverables Only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_family",
    "schema_version",
    "project_id",
    "deliverables"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_family": {"const": "production-manifest"},
    "schema_version": {"const": "1.2.0"},
    "project_id": {"type": "string", "pattern": "^PRJ-[0-9]{3,}$"},
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "contains": {"$ref": "#/$defs/readableDeliverable"},
      "minContains": 1,
      "maxContains": 1,
      "items": {"$ref": "#/$defs/readableDeliverable"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "readableDeliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_name",
        "path",
        "sha256",
        "source_report_sha256",
        "profile_id",
        "profile_version"
      ],
      "properties": {
        "artifact_name": {"const": "production_broadcast_readable_script"},
        "path": {"const": "09_PRODUCTION/broadcast_readable_script.md"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "source_report_sha256": {"$ref": "#/$defs/sha256"},
        "profile_id": {"const": "BROADCAST_READABLE_SCRIPT"},
        "profile_version": {"const": "2.0.0"}
      }
    }
  }
}
