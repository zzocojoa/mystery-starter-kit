{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/expert-segments-1.0.0.json",
  "title": "Expert Analysis Segments",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_family", "schema_version", "project_id", "status", "segments"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_family": {"const": "expert-segments"},
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "pattern": "^PRJ-[0-9]{3,}$"},
    "status": {"enum": ["PLANNED", "NOT_APPLICABLE"]},
    "not_applicable_reason": {"type": "string", "minLength": 1},
    "segments": {
      "type": "array",
      "items": {"$ref": "#/$defs/expertSegment"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PLANNED"}}},
      "then": {"properties": {"segments": {"minItems": 1}}},
      "else": {
        "required": ["not_applicable_reason"],
        "properties": {"segments": {"maxItems": 0}}
      }
    }
  ],
  "$defs": {
    "idList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2,}$"}
    },
    "expertSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "scene_id",
        "expert_id",
        "expert_role",
        "function",
        "credentials",
        "claim_ids",
        "evidence_source_ids",
        "spoken_line",
        "confidence",
        "limitations"
      ],
      "properties": {
        "segment_id": {"type": "string", "pattern": "^SEG-[0-9]{3,}$"},
        "scene_id": {"type": "string", "pattern": "^SCN-[0-9]{2,}$"},
        "expert_id": {"type": "string", "pattern": "^EXPERT-[0-9]{2,}$"},
        "expert_role": {
          "enum": [
            "CLINICAL_PSYCHOLOGIST",
            "FORENSIC_PSYCHOLOGIST",
            "CRIMINOLOGIST",
            "VICTIM_ADVOCATE",
            "LEGAL_EXPERT"
          ]
        },
        "function": {
          "enum": [
            "RISK_CONTEXT",
            "BEHAVIORAL_ANALYSIS",
            "CLINICAL_CONTEXT",
            "SOURCE_CONTEXT"
          ]
        },
        "credentials": {"type": "string", "minLength": 1},
        "claim_ids": {"$ref": "#/$defs/idList"},
        "evidence_source_ids": {"$ref": "#/$defs/idList"},
        "spoken_line": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "limitations": {"type": "string", "minLength": 1}
      }
    }
  }
}
