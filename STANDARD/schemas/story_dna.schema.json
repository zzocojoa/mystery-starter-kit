{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/story-dna-1.3.0.json",
  "title": "Story DNA v1.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_family",
    "schema_version",
    "project_id",
    "story_source_mode",
    "story_dna"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_family": {
      "const": "story-dna"
    },
    "schema_version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "project_id": {
      "$ref": "#/$defs/projectId"
    },
    "story_source_mode": {
      "enum": [
        "ORIGINAL",
        "USER_CASE",
        "REFERENCE_INSPIRED",
        "TRUE_STORY",
        "INSPIRED_BY_TRUE_EVENTS"
      ]
    },
    "reference_profile": {
      "$ref": "#/$defs/referenceProfile"
    },
    "story_dna": {
      "$ref": "#/$defs/storyDna"
    },
    "variation_overrides": {
      "type": "object",
      "additionalProperties": true
    },
    "override_reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "story_source_mode": {
            "const": "REFERENCE_INSPIRED"
          }
        }
      },
      "then": {
        "required": ["reference_profile"]
      }
    },
    {
      "if": {
        "required": ["variation_overrides"]
      },
      "then": {
        "required": ["override_reason"]
      }
    }
  ],
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^PRJ-[0-9]{3,}$"
    },
    "enumName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "enumList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/enumName"
      }
    },
    "referenceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_id",
        "allowed_style_features",
        "prohibited_story_content",
        "separation_attestation"
      ],
      "properties": {
        "reference_id": {
          "type": "string",
          "pattern": "^REF-[0-9]{3,}$"
        },
        "allowed_style_features": {
          "$ref": "#/$defs/enumList"
        },
        "prohibited_story_content": {
          "$ref": "#/$defs/enumList"
        },
        "separation_attestation": {
          "const": true
        }
      }
    },
    "relationshipEngine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "protagonist_counterpart_role"],
      "properties": {
        "primary": {
          "$ref": "#/$defs/enumName"
        },
        "secondary": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/enumName"
          }
        },
        "protagonist_counterpart_role": {
          "$ref": "#/$defs/enumName"
        }
      }
    },
    "pressureEngine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "escalation", "stakes"],
      "properties": {
        "source": {
          "$ref": "#/$defs/enumName"
        },
        "escalation": {
          "enum": ["RISING", "WAVE", "COUNTDOWN", "SQUEEZE", "CASCADE"]
        },
        "stakes": {
          "$ref": "#/$defs/enumList"
        }
      }
    },
    "dramaticEngine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "audience_emotion_curve"],
      "properties": {
        "primary": {
          "$ref": "#/$defs/enumName"
        },
        "secondary": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/enumName"
          }
        },
        "audience_emotion_curve": {
          "$ref": "#/$defs/enumList"
        }
      }
    },
    "audienceExperience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_belief", "midpoint_shift", "final_reframe"],
      "properties": {
        "initial_belief": {
          "type": "string",
          "minLength": 1
        },
        "midpoint_shift": {
          "type": "string",
          "minLength": 1
        },
        "final_reframe": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "clinicalLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "classification", "asserted_as_fact"],
      "properties": {
        "term": {"type": "string", "minLength": 1},
        "classification": {
          "enum": [
            "CONFIRMED_DIAGNOSIS",
            "EXPERT_ASSESSMENT",
            "MEDIA_DESCRIPTION",
            "NARRATOR_OPINION",
            "UNVERIFIED_LABEL"
          ]
        },
        "claim_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2,}$"},
        "expert_id": {"type": "string", "pattern": "^EXPERT-[0-9]{2,}$"},
        "asserted_as_fact": {"type": "boolean"}
      }
    },
    "expertDebriefPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["PLANNED", "NOT_APPLICABLE"]},
        "expert_role": {"type": "string", "minLength": 1},
        "claim_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2,}$"}
        },
        "na_reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "PLANNED"}}},
          "then": {
            "required": ["expert_role", "claim_ids"],
            "properties": {"claim_ids": {"minItems": 1}}
          }
        },
        {
          "if": {"properties": {"status": {"const": "NOT_APPLICABLE"}}},
          "then": {
            "required": ["na_reason"],
            "properties": {"claim_ids": {"maxItems": 0}}
          }
        }
      ]
    },
    "storyDna": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "mystery_type",
        "architecture",
        "protagonist_role",
        "perspective",
        "narrator_reliability",
        "timeline_style",
        "incident_type",
        "setting",
        "culprit_structure",
        "primary_twist",
        "information_mechanism",
        "clue_mechanism",
        "emotional_engine",
        "relationship_engine",
        "pressure_engine",
        "dramatic_engine",
        "thematic_question",
        "audience_experience",
        "reveal_mode",
        "ending_type"
      ],
      "properties": {
        "mystery_type": {
          "enum": ["WHO", "WHOSE", "WHY", "HOW", "WHEN", "WHERE", "WHETHER", "WHAT"]
        },
        "architecture": {
          "type": "string",
          "pattern": "^ARCH-[0-9]{2}_[A-Z0-9_]+$"
        },
        "protagonist_role": {
          "enum": [
            "INVESTIGATOR",
            "SUSPECT",
            "WITNESS",
            "VICTIM",
            "OUTSIDER",
            "ACCOMPLICE",
            "SURVIVOR",
            "VICTIM_FAMILY",
            "CULPRIT_FAMILY",
            "REPORTER",
            "EMPLOYEE",
            "MANAGER",
            "NEIGHBOR",
            "FRIEND",
            "PARTNER",
            "EX_PARTNER",
            "AUTHORITY",
            "CULPRIT",
            "UNWITTING_PARTICIPANT"
          ]
        },
        "perspective": {
          "enum": [
            "FIRST_PERSON",
            "THIRD_PERSON_LIMITED",
            "MULTIPLE_POV",
            "OMNISCIENT",
            "FOUND_FOOTAGE",
            "DOCUMENTARY",
            "INTERVIEW_BASED",
            "SCREENLIFE"
          ]
        },
        "narrator_reliability": {
          "enum": [
            "RELIABLE",
            "UNRELIABLE_MEMORY",
            "UNRELIABLE_BIAS",
            "DECEPTIVE",
            "MULTIPLE_CONFLICTING"
          ]
        },
        "timeline_style": {
          "enum": [
            "LINEAR",
            "FLASHBACK_DRIVEN",
            "REVERSE",
            "DUAL_TIMELINE",
            "FRAGMENTED",
            "PARALLEL",
            "REAL_TIME",
            "LOOP"
          ]
        },
        "incident_type": {
          "$ref": "#/$defs/enumName"
        },
        "setting": {
          "$ref": "#/$defs/enumName"
        },
        "setting_logic": {
          "$ref": "#/$defs/enumList"
        },
        "culprit_structure": {
          "enum": [
            "SINGLE",
            "DUAL",
            "MULTIPLE",
            "ACCOMPLICE",
            "NO_CULPRIT",
            "VICTIM_SELF_ENGINEERED",
            "SYSTEMIC_CAUSE",
            "ACCIDENTAL",
            "UNKNOWN"
          ]
        },
        "causal_truth": {
          "type": "string",
          "minLength": 1
        },
        "primary_twist": {
          "type": "string",
          "pattern": "^TW-[0-9]{2}_[A-Z0-9_]+$"
        },
        "secondary_twists": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^TW-[0-9]{2}_[A-Z0-9_]+$"
          }
        },
        "information_mechanism": {
          "$ref": "#/$defs/enumList"
        },
        "clue_mechanism": {
          "$ref": "#/$defs/enumList"
        },
        "motive_class": {
          "$ref": "#/$defs/enumName"
        },
        "emotional_engine": {
          "$ref": "#/$defs/enumName"
        },
        "relationship_engine": {
          "$ref": "#/$defs/relationshipEngine"
        },
        "pressure_engine": {
          "$ref": "#/$defs/pressureEngine"
        },
        "dramatic_engine": {
          "$ref": "#/$defs/dramaticEngine"
        },
        "thematic_question": {
          "type": "string",
          "minLength": 1
        },
        "audience_experience": {
          "$ref": "#/$defs/audienceExperience"
        },
        "reveal_mode": {
          "$ref": "#/$defs/enumName"
        },
        "ending_type": {
          "enum": [
            "CLOSED",
            "OPEN",
            "AMBIGUOUS",
            "BITTERSWEET",
            "TRAGIC",
            "FALSE_RESOLUTION",
            "CIRCULAR",
            "MORAL_REVERSAL"
          ]
        },
        "threat_type": {
          "$ref": "#/$defs/enumName"
        },
        "trusted_domain": {
          "$ref": "#/$defs/enumName"
        },
        "safe_domain_expectation": {
          "type": "string",
          "minLength": 1
        },
        "early_warning_signals": {
          "$ref": "#/$defs/enumList"
        },
        "boundary_erosion_steps": {
          "$ref": "#/$defs/enumList"
        },
        "control_tactics": {
          "$ref": "#/$defs/enumList"
        },
        "victim_exit_barriers": {
          "$ref": "#/$defs/enumList"
        },
        "harm_mechanism": {
          "type": "string",
          "minLength": 1
        },
        "responsible_agent": {
          "type": "string",
          "minLength": 1
        },
        "responsible_agent_payoff": {
          "type": "string",
          "minLength": 1
        },
        "victim_agency_outcome": {
          "type": "string",
          "minLength": 1
        },
        "psychological_pressure": {
          "type": "string",
          "minLength": 1
        },
        "risk_signal_payoff": {
          "type": "string",
          "minLength": 1
        },
        "source_disclosure_mode": {
          "enum": [
            "VERIFIED_TRUE_CASE",
            "INSPIRED_BY_TRUE_EVENTS",
            "ORIGINAL_FICTION"
          ]
        },
        "clinical_label_classification": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/clinicalLabel"}
        },
        "expert_debrief_plan": {
          "$ref": "#/$defs/expertDebriefPlan"
        },
        "episode_theme": {
          "$ref": "#/$defs/enumName"
        }
      }
    }
  }
}
