{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/psychological-arc-1.0.0.json",
  "title": "Psychological Arc v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_family",
    "schema_version",
    "project_id",
    "primary_story_engine",
    "stages"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_family": {"const": "psychological-arc"},
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "pattern": "^PRJ-[0-9]{3,}$"},
    "primary_story_engine": {"const": "CRIME_PSYCHOLOGICAL_ESCALATION"},
    "stages": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {"$ref": "#/$defs/stage"}
    }
  },
  "$defs": {
    "stageType": {
      "enum": [
        "TRUST_FORMATION",
        "EARLY_WARNING",
        "RATIONALIZATION",
        "BOUNDARY_EROSION",
        "CONTROL_OR_DEPENDENCY",
        "PSYCHOLOGICAL_CONSEQUENCE",
        "HARM_OR_CRIME",
        "RECOGNITION_AND_RESISTANCE",
        "AGENCY_RECOVERY"
      ]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "order",
        "stage_type",
        "actor_id",
        "subject_id",
        "state_before",
        "state_after",
        "experience_goal",
        "required_drama_evidence"
      ],
      "properties": {
        "stage_id": {"type": "string", "pattern": "^PSTAGE-[0-9]{3,}$"},
        "order": {"type": "integer", "minimum": 1, "maximum": 9},
        "stage_type": {"$ref": "#/$defs/stageType"},
        "actor_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2,}$"},
        "subject_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2,}$"},
        "state_before": {"type": "string", "minLength": 1},
        "state_after": {"type": "string", "minLength": 1},
        "experience_goal": {"type": "string", "minLength": 1},
        "required_drama_evidence": {"const": true}
      }
    }
  }
}
