{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/fact-evidence-1.0.0.json",
  "title": "True Story Fact and Evidence Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["facts", "sources", "claims"],
  "properties": {
    "facts": {
      "type": "array",
      "items": {"$ref": "#/$defs/fact"}
    },
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    },
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2,}$"},
    "idList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "statement", "classification", "normalized_statement_hash"],
      "properties": {
        "fact_id": {"$ref": "#/$defs/id"},
        "statement": {"type": "string", "minLength": 1},
        "classification": {"enum": ["FACT", "INFERENCE", "DRAMATIZATION"]},
        "normalized_statement_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_ids": {"$ref": "#/$defs/idList"},
        "basis_fact_ids": {"$ref": "#/$defs/idList"},
        "presented_as_fact": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"classification": {"const": "FACT"}}},
          "then": {"required": ["source_ids"]}
        },
        {
          "if": {"properties": {"classification": {"const": "INFERENCE"}}},
          "then": {"required": ["basis_fact_ids"]}
        },
        {
          "if": {"properties": {"classification": {"const": "DRAMATIZATION"}}},
          "then": {
            "required": ["presented_as_fact"],
            "properties": {"presented_as_fact": {"const": false}}
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source_id", "url"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "url": {"type": "string", "minLength": 1}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "claim",
        "classification",
        "canonical_claim_hash",
        "evidence_source_ids",
        "basis_fact_ids",
        "evidence_scope",
        "confidence",
        "presented_as_fact"
      ],
      "properties": {
        "fact_id": {"$ref": "#/$defs/id"},
        "claim": {"type": "string", "minLength": 1},
        "classification": {"enum": ["FACT", "INFERENCE", "DRAMATIZATION"]},
        "canonical_claim_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evidence_source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "basis_fact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "evidence_scope": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "presented_as_fact": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"classification": {"const": "FACT"}}},
          "then": {
            "properties": {
              "evidence_source_ids": {"minItems": 1},
              "presented_as_fact": {"const": true}
            }
          }
        },
        {
          "if": {"properties": {"classification": {"const": "INFERENCE"}}},
          "then": {"properties": {"basis_fact_ids": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"classification": {"const": "DRAMATIZATION"}}},
          "then": {"properties": {"presented_as_fact": {"const": false}}}
        }
      ]
    }
  }
}
