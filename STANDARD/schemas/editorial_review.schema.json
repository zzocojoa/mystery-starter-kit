{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/editorial-review-1.2.0.json",
  "title": "Editorial Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_family",
    "schema_version",
    "project_id",
    "reviewer",
    "reviewed_at",
    "artifact_hashes",
    "runtime_evidence",
    "result",
    "checks",
    "issues"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_family": {"const": "editorial-review"},
    "schema_version": {"const": "1.2.0"},
    "project_id": {"type": "string", "pattern": "^PRJ-[0-9]{3,}$"},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "role"],
      "properties": {
        "reviewer_id": {
          "type": ["string", "null"],
          "pattern": "^(agent|human):[a-z][a-z0-9_-]+$"
        },
        "role": {"enum": ["CONTINUITY_CRITIC", "HUMAN_EDITOR", null]}
      }
    },
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "psychological_arc": {"$ref": "#/$defs/sha256"},
        "character_state_transitions": {"$ref": "#/$defs/sha256"},
        "crime_event_contract": {"$ref": "#/$defs/sha256"},
        "scene_cards": {"$ref": "#/$defs/sha256"},
        "final_script": {"$ref": "#/$defs/sha256"},
        "screenplay_units": {"$ref": "#/$defs/sha256"},
        "reenactment_character_script": {"$ref": "#/$defs/sha256"},
        "reenactment_export_report": {"$ref": "#/$defs/sha256"},
        "script_realization_report": {"$ref": "#/$defs/sha256"},
        "actual_timeline": {"$ref": "#/$defs/sha256"},
        "viewer_timeline": {"$ref": "#/$defs/sha256"},
        "audience_belief": {"$ref": "#/$defs/sha256"},
        "panel_cast": {"$ref": "#/$defs/sha256"},
        "reaction_segments": {"$ref": "#/$defs/sha256"},
        "expert_segments": {"$ref": "#/$defs/sha256"},
        "presentation_plan": {"$ref": "#/$defs/sha256"},
        "panel_reaction_script": {"$ref": "#/$defs/sha256"},
        "expert_analysis_script": {"$ref": "#/$defs/sha256"},
        "production_footprint": {"$ref": "#/$defs/sha256"},
        "shooting_script": {"$ref": "#/$defs/sha256"},
        "production_manifest": {"$ref": "#/$defs/sha256"},
        "narration": {"$ref": "#/$defs/sha256"},
        "production_panel_reaction_script": {"$ref": "#/$defs/sha256"},
        "production_expert_analysis_script": {"$ref": "#/$defs/sha256"},
        "subtitle_script": {"$ref": "#/$defs/sha256"},
        "edit_script": {"$ref": "#/$defs/sha256"},
        "production_reenactment_character_script": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtime_evidence": {"$ref": "#/$defs/runtimeEvidence"},
    "semantic_assessments": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/semanticAssessment"}
    },
    "result": {"enum": ["PENDING", "PASS", "FAIL"]},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "broadcast_format",
        "absolute_time",
        "dialogue_naturalness",
        "panel_reaction_function",
        "audience_belief",
        "shootability",
        "victim_dignity"
      ],
      "properties": {
        "broadcast_format": {"$ref": "#/$defs/check"},
        "absolute_time": {"$ref": "#/$defs/check"},
        "dialogue_naturalness": {"$ref": "#/$defs/check"},
        "panel_reaction_function": {"$ref": "#/$defs/check"},
        "audience_belief": {"$ref": "#/$defs/check"},
        "shootability": {"$ref": "#/$defs/check"},
        "victim_dignity": {"$ref": "#/$defs/check"}
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message", "owner_agent"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "severity": {"enum": ["ERROR", "WARN", "INFO"]},
          "message": {"type": "string", "minLength": 1},
          "owner_agent": {
            "enum": ["script_writer", "scene_designer", "orchestrator"]
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "evidence", "notes"],
      "properties": {
        "result": {"enum": ["PENDING", "PASS", "FAIL"]},
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidenceReference"}
        },
        "notes": {"type": "string"}
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "selector_type", "selector_id", "excerpt_hash"],
      "properties": {
        "artifact": {
          "enum": [
            "psychological_arc",
            "character_state_transitions",
            "crime_event_contract",
            "scene_cards",
            "final_script",
            "screenplay_units",
            "reenactment_character_script",
            "reenactment_export_report",
            "script_realization_report",
            "actual_timeline",
            "viewer_timeline",
            "audience_belief",
            "panel_cast",
            "reaction_segments",
            "expert_segments",
            "presentation_plan",
            "panel_reaction_script",
            "expert_analysis_script",
            "production_footprint",
            "shooting_script",
            "production_manifest",
            "narration",
            "production_panel_reaction_script",
            "production_expert_analysis_script",
            "subtitle_script",
            "edit_script",
            "production_reenactment_character_script"
          ]
        },
        "selector_type": {
          "enum": [
            "DOCUMENT",
            "SEGMENT_ID",
            "REACTION_SEGMENT_ID",
            "SCENE_ID",
            "PSYCHOLOGICAL_STAGE_ID",
            "EVENT_ID",
            "FACT_ID",
            "CLUE_ID",
            "REVEAL_TARGET_ID",
            "UNIT_ID"
          ]
        },
        "selector_id": {"type": "string", "minLength": 1},
        "excerpt_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "nonSpeechElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element_type", "duration_sec", "notes"],
      "properties": {
        "element_type": {
          "enum": [
            "HOST_PROMPT",
            "CROSS_TALK_PAUSE",
            "REPLAY",
            "GRAPHIC",
            "REACTION_HOLD",
            "B_ROLL",
            "TRANSITION",
            "OTHER"
          ]
        },
        "duration_sec": {"type": "number", "exclusiveMinimum": 0},
        "time_class": {"enum": ["ACTION", "NON_SPEAKING"]},
        "support_status": {"enum": ["SUPPORTED", "UNSUPPORTED"]},
        "source_reference": {"type": "string", "minLength": 1},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "panelSegmentRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "reaction_segment_id",
        "planned_duration_sec",
        "spoken_word_count",
        "estimated_spoken_duration_sec",
        "measured_duration_sec",
        "speaker_ids",
        "non_speech_elements"
      ],
      "properties": {
        "segment_id": {"type": "string", "pattern": "^SEG-[0-9]{3,}$"},
        "reaction_segment_id": {
          "type": "string",
          "pattern": "^RSEG-[0-9]{3,}$"
        },
        "planned_duration_sec": {"type": "number", "exclusiveMinimum": 0},
        "spoken_word_count": {"type": "integer", "minimum": 1},
        "estimated_spoken_duration_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "action_duration_sec": {"type": "number", "minimum": 0},
        "non_speaking_duration_sec": {"type": "number", "minimum": 0},
        "measured_duration_sec": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "speaker_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^PANEL-[0-9]{2,}$"}
        },
        "non_speech_elements": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/nonSpeechElement"}
        }
      }
    },
    "runtimeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "reading_rate_wpm",
        "planned_runtime_sec",
        "planned_panel_duration_sec",
        "estimated_panel_spoken_duration_sec",
        "measured_panel_duration_sec",
        "panel_segments"
      ],
      "properties": {
        "language_unit": {"const": "KOREAN_EOJEOL"},
        "estimation_assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "method": {
          "enum": ["PENDING", "WORD_COUNT_ESTIMATE", "TABLE_READ", "RECORDED_AUDIO"]
        },
        "reading_rate_wpm": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "planned_runtime_sec": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "planned_panel_duration_sec": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "estimated_panel_spoken_duration_sec": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "measured_panel_duration_sec": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "panel_segments": {
          "type": "array",
          "items": {"$ref": "#/$defs/panelSegmentRuntime"}
        }
      }
    },
    "semanticAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessment_id", "category", "subject_id", "status", "evidence", "notes"],
      "properties": {
        "assessment_id": {"type": "string", "pattern": "^ASSESS-[0-9]{2,}$"},
        "category": {"enum": ["CRIME_EVENT_REALIZATION", "CRIME_ACTION", "HARM_RESULT", "DEVELOPMENT_FUNCTION", "NARRATION_FUNCTION", "PANEL_FUNCTION", "REVEAL_TIMING", "PREMATURE_DISCLOSURE_SCAN", "CLUE_AND_EVIDENCE_COHERENCE"]},
        "subject_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["EVIDENCED", "MISSING", "NEEDS_REVIEW", "NOT_DISCLOSED", "INTENTIONAL_PREREVEAL", "PREMATURE_DISCLOSURE"]},
        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceReference"}},
        "notes": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"result": {"const": "PASS"}},
        "required": ["result"]
      },
      "then": {
        "properties": {
          "reviewer": {
            "properties": {
              "reviewer_id": {"type": "string"},
              "role": {"type": "string"}
            }
          },
          "reviewed_at": {"type": "string"},
          "artifact_hashes": {
            "required": [
              "final_script",
              "actual_timeline",
              "viewer_timeline",
              "audience_belief",
              "panel_cast",
              "reaction_segments",
              "presentation_plan",
              "panel_reaction_script",
              "shooting_script",
              "narration",
              "production_panel_reaction_script",
              "subtitle_script",
              "edit_script"
            ]
          },
          "runtime_evidence": {
            "properties": {
              "method": {
                "enum": ["WORD_COUNT_ESTIMATE", "TABLE_READ", "RECORDED_AUDIO"]
              },
              "panel_segments": {"minItems": 1}
            }
          }
        }
      }
    }
  ]
}
