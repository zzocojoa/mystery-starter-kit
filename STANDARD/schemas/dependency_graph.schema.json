{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/dependency-graph-1.0.0.json",
  "title": "Project Artifact Dependency Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_family", "schema_version", "artifacts"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_family": {
      "const": "dependency-graph"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "depends_on", "owner_agent"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "owner_agent": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minimum_channel_content_version": {
            "$ref": "#/$defs/semanticVersion"
          }
        }
      }
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  }
}
