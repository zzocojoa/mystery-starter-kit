{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/dependency-graph-1.0.0.json",
  "title": "Project Artifact Dependency Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_family", "schema_version", "artifacts"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_family": {
      "const": "dependency-graph"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "depends_on", "owner_agent"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "owner_agent": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minimum_channel_content_version": {
            "$ref": "#/$defs/semanticVersion"
          },
          "required_when_capability_enabled": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "required_when_source_truth": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["ORIGINAL_FICTION", "VERIFIED_TRUE_CASE", "INSPIRED_BY_TRUE_EVENTS"]
            }
          },
          "required_when_plan_status": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact", "status"],
            "properties": {
              "artifact": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "status": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  }
}
