{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/project-constraints-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_family", "schema_version", "project_id", "must_use", "must_not_use", "production_limits"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_family": {"const": "project-constraints"},
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "pattern": "^PRJ-[0-9]{3,}$"},
    "must_use": {"$ref": "#/$defs/rules"},
    "must_not_use": {"$ref": "#/$defs/rules"},
    "production_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_locations", "max_major_characters", "max_production_complexity", "max_special_effect_level", "allow_child_actor", "allow_moving_vehicle", "max_graphic_violence"],
      "properties": {
        "max_locations": {"type": "integer", "minimum": 1},
        "max_major_characters": {"type": "integer", "minimum": 1},
        "max_production_complexity": {"enum": ["LOW", "MEDIUM", "HIGH", "EXTREME"]},
        "max_special_effect_level": {"enum": ["NONE", "LOW", "MEDIUM", "HIGH"]},
        "allow_child_actor": {"type": "boolean"},
        "allow_moving_vehicle": {"type": "boolean"},
        "max_graphic_violence": {"enum": ["NONE", "IMPLIED", "NON_GRAPHIC", "GRAPHIC"]},
        "enforce_final_footprint": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "values"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "operator": {"enum": ["IN", "NOT_IN"]},
        "values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
