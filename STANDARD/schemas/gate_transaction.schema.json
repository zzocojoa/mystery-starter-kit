{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/gate-transaction-1.0.0.json",
  "title": "Codex App Gate Transaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_family",
    "schema_version",
    "transaction_id",
    "project_id",
    "gate_id",
    "task_ids",
    "agent_ids",
    "allowed_reads",
    "allowed_writes",
    "input_hashes",
    "canonical_hashes",
    "workspace_hashes",
    "forbidden_paths",
    "workspace",
    "status",
    "changed_paths",
    "commit_sha",
    "started_at",
    "completed_at"
  ],
  "properties": {
    "schema_family": {
      "const": "gate-transaction"
    },
    "schema_version": {
      "enum": ["1.0.0", "1.1.0"]
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^CODEX-TASK-[A-F0-9]{16}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^PRJ-[0-9]{3,}$"
    },
    "gate_id": {
      "type": "string",
      "pattern": "^GATE-(0[0-9]|1[0-3])$"
    },
    "process_revision": {
      "type": "integer",
      "minimum": 1
    },
    "revision_trigger": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/revisionTrigger"}
      ]
    },
    "task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "current_task_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "completed_task_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "task_statuses": {
      "type": "object",
      "additionalProperties": {
        "enum": ["PENDING", "RUNNING_CORE", "AWAITING_LLM", "WAITING_HUMAN", "COMPLETED"]
      }
    },
    "task_input_hashes": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/hashMap"}
    },
    "task_changed_paths": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "task_execution_modes": {
      "type": "object",
      "additionalProperties": {
        "enum": ["EXECUTED", "VALIDATED_REUSE"]
      }
    },
    "reused_trace_ids": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^TRACE-[A-F0-9]{16}$"
      }
    },
    "gate_phase": {
      "enum": ["RUNNING_CORE", "AWAITING_LLM", "WAITING_HUMAN", "READY_TO_COMMIT", "COMMITTED", "ABORTED"]
    },
    "agent_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "allowed_reads": {
      "$ref": "#/$defs/artifactNames"
    },
    "allowed_writes": {
      "$ref": "#/$defs/artifactNames"
    },
    "input_hashes": {
      "$ref": "#/$defs/hashMap"
    },
    "canonical_hashes": {
      "$ref": "#/$defs/pathHashMap"
    },
    "workspace_hashes": {
      "$ref": "#/$defs/pathHashMap"
    },
    "forbidden_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["OPEN", "COMMITTED", "ABORTED"]
    },
    "changed_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commit_sha": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": "1.1.0"}},
        "required": ["schema_version"]
      },
      "then": {
        "required": [
          "current_task_id",
          "completed_task_ids",
          "task_statuses",
          "task_input_hashes",
          "task_changed_paths",
          "gate_phase"
        ]
      }
    }
  ],
  "$defs": {
    "artifactNames": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "hashMap": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "pathHashMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "revisionTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "source_id",
        "target_owner_agent",
        "target_gate",
        "target_task_ids",
        "actor",
        "reason",
        "triggered_at"
      ],
      "properties": {
        "type": {
          "enum": [
            "CONFIG_ADMISSION",
            "OWNER_RETURN",
            "HUMAN_REVISION_REQUEST",
            "SEMANTIC_CORRECTION",
            "NORMAL_GATE_PROGRESS"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "target_owner_agent": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "target_gate": {
          "type": ["string", "null"],
          "pattern": "^GATE-(0[0-9]|1[0-3])$"
        },
        "target_task_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "actor": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "triggered_at": {
          "type": "string",
          "format": "date-time"
        },
        "returned_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
